<main class="w-full h-full p-4 pl-20 pb-20 overflow-auto text-gray-200">
  <%!-- CHEWY PATCH: the toolbar's filters survive a reload. Upstream's
        generic hook pushes `ls_restore_scout_filters` on mount and takes
        `ls_update_scout_filters` on every change. --%>
  <div
    id="scout-filter-store"
    phx-hook="LocalStorageSetting"
    data-key="scout_filters"
    class="hidden"
  >
  </div>
  
  <%!-- CHEWY PATCH (panel layout): board order and collapsed set, own
        key. See `WandererAppWeb.ScoutLayout`. --%>
  <div
    id="scout-layout-store"
    phx-hook="LocalStorageSetting"
    data-key="scout_layout"
    class="hidden"
  >
  </div>
  
  <.scout_header active={@tab} planner?={WandererApp.Env.scout_planner_enabled?()} live?={true}>
    <:meta :if={@tab != :planner}>
      structures <span class="text-gray-300">{ago(@last_observed.structures, @now)}</span>
      · spawns <span class="text-gray-300">{ago(@last_observed.spawns, @now)}</span>
      · times UTC
    </:meta>
    
    <:actions :if={@tab != :planner}>
      <a
        href={export_path(assigns)}
        class="btn btn-sm btn-ghost"
        download
        title="The rows below, every stored column, as CSV"
      >
        Export CSV
      </a>
      
      <button
        phx-click="discord"
        phx-value-board="digest"
        class="btn btn-sm btn-ghost"
        title="Every board on this tab as Discord messages you can select and paste"
      >
        Discord report
      </button>
       <button phx-click="refresh" class="btn btn-sm btn-ghost">Refresh</button>
      <%!-- CHEWY PATCH: the asset-safety opt-in. One EVE SSO round trip
            per character; the scope cannot be added to a token that
            already exists. See the handler for the invite-gate trap. --%>
      <button
        :if={asset_safety_enabled?()}
        phx-click="request_notification_access"
        class="btn btn-sm btn-ghost"
        title="Log in one character so EVE's asset-safety notifications reach this page. Read-only, and only that one scope is added."
      >
        Watch notifications
      </button>
      
      <%!-- CHEWY PATCH: whose autopilot every ⤳ below writes to. In the
            header rather than per board, because it is one choice for
            the whole page and repeating it is how two boards end up
            flying two different pilots. --%>
      <.pilot_picker
        characters={@characters}
        character_eve_id={@character_eve_id}
        status={@waypoint_status}
      />
      <.link :if={@can_manage_access?} navigate={~p"/scout/access"} class="btn btn-sm">
        Manage access
      </.link>
    </:actions>
  </.scout_header>
  
  <%!-- CHEWY PATCH: above the unanchored bar on purpose — this one is
        EVE saying a decommission COMPLETED at a known instant, not a
        sweep reporting what it happened to fly past. --%>
  <.asset_safety_alert
    :if={@tab != :planner and asset_safety_enabled?()}
    rows={@asset_safety_events}
    systems={@systems}
    now={@now}
    horizon_days={asset_safety_horizon_days()}
  />
  <.unanchored_alert
    :if={@tab != :planner}
    rows={@unanchored_structures}
    systems={@systems}
    now={@now}
    horizon_days={unanchored_horizon_days()}
  />
  <.scout_toolbar :if={@tab != :planner}>
    <form phx-change="select_window">
      <select
        name="days"
        id="scout-window"
        title="Window — the log tables below are bounded by this"
        class="select select-sm select-bordered bg-neutral-950/60 w-32 py-0"
      >
        <option :for={{label, days} <- @windows} value={days} selected={days == @days}>
          Last {label}
        </option>
      </select>
    </form>
    
    <form phx-change="search" class="grow min-w-[180px] max-w-sm">
      <input
        type="text"
        name="q"
        id="scout-search"
        value={@q}
        phx-debounce="300"
        autocomplete="off"
        placeholder={
          if @tab == :structures,
            do: "Search structure, owner, system, type…",
            else: "Search spawn, belt, system, category…"
        }
        class="input input-sm input-bordered w-full bg-neutral-950/60"
      />
    </form>
    
    <div class="join" id="scout-space-filter">
      <.space_chip
        :for={{key, label} <- @space_types}
        key={key}
        label={label}
        selected={key in @space}
      />
    </div>
    
    <button
      :if={@system_id}
      phx-click="clear_system"
      id="scout-system-filter"
      class="btn btn-sm btn-outline btn-warning gap-1"
      title="Clear the system filter"
    >
      {system_region(%{solar_system_id: @system_id, solar_system_name: nil}, @systems)} ✕
    </button>
    
    <button
      :if={length(@space) < length(@space_types)}
      phx-click="reset_space"
      id="scout-space-reset"
      class="btn btn-sm btn-ghost text-gray-400"
      title="Select every space type again"
    >
      All space ✕
    </button>
    
    <%!-- CHEWY PATCH: a soloed board is a mode, and a mode with no way
          out reads as a broken page. The card stays ring-highlighted
          and clicking it again restores the rest; this is the second
          way, next to every other filter's. --%>
    <button
      :if={@board}
      phx-click="clear_board"
      id="scout-board-reset"
      class="btn btn-sm btn-outline gap-1"
      title="Show every board again"
    >
      Only {@board} ✕
    </button>
    
    <%!-- CHEWY PATCH (panel layout): the whole page's boards, in one
          control. Per-board chevrons alone make "just show me Now" a
          dozen clicks. --%>
    <.layout_controls layout={@panel_layout} class="ml-auto" />
  </.scout_toolbar>
  
  <div :if={@tab == :structures} class="grid grid-cols-2 lg:grid-cols-4 xl:grid-cols-8 gap-3 mb-5">
    <.stat
      :if={asset_safety_enabled?()}
      id="scout-stat-asset-safety"
      label="Asset safety"
      board="asset_safety"
      active={@board == "asset_safety"}
      value={to_string(length(@asset_safety_events))}
      hint={"last #{asset_safety_horizon_days()}d"}
      tone={if @asset_safety_events != [], do: :urgent, else: :neutral}
    />
    <.stat
      :if={asset_safety_enabled?()}
      id="scout-stat-unarmed"
      label="Needs seeding"
      board="unarmed"
      active={@board == "unarmed"}
      value={to_string(length(@unarmed_structures))}
      hint="no item inside"
      tone={if @unarmed_structures != [], do: :warn, else: :good}
    />
    <.stat
      id="scout-stat-unanchored"
      label="Unanchored"
      board="unanchored"
      active={@board == "unanchored"}
      value={to_string(length(@unanchored_structures))}
      hint={"last #{unanchored_horizon_days()}d"}
      tone={if @unanchored_structures != [], do: :urgent, else: :neutral}
    />
    <.stat
      id="scout-stat-timers"
      label="Timers running"
      board="timers"
      active={@board == "timers"}
      value={to_string(length(@active_timers))}
      hint={timer_hint(@active_timers, @now)}
      tone={if urgent_timers(@active_timers, @now) > 0, do: :urgent, else: :neutral}
    />
    <.stat
      id="scout-stat-anchoring"
      label="Anchoring"
      board="anchoring"
      active={@board == "anchoring"}
      value={to_string(length(@anchoring_structures))}
      tone={if @anchoring_structures != [], do: :warn, else: :neutral}
    />
    <.stat
      id="scout-stat-unanchoring"
      label="Unanchoring"
      board="unanchoring"
      active={@board == "unanchoring"}
      value={to_string(length(@unanchoring_structures))}
      tone={if @unanchoring_structures != [], do: :warn, else: :neutral}
    />
    <.stat
      id="scout-stat-sorted"
      label="Sorted elsewhere"
      board="sorted"
      active={@board == "sorted"}
      value={to_string(length(@sorted_structures))}
      hint="runs that ended without us"
      tone={:neutral}
    />
    <.stat
      id="scout-stat-abandoned"
      label="Abandoned"
      board="abandoned"
      active={@board == "abandoned"}
      value={to_string(length(@abandoned_structures))}
      hint="asset safety off"
      tone={if @abandoned_structures != [], do: :good, else: :neutral}
    />
    <.stat
      id="scout-stat-no-fuel"
      label="No fuel"
      board="no_fuel"
      active={@board == "no_fuel"}
      value={to_string(length(@no_fuel_structures))}
      hint="low power"
      tone={if @no_fuel_structures != [], do: :good, else: :neutral}
    />
    <.stat
      id="scout-stat-log"
      label="Structures seen"
      board="log"
      active={@board == "log"}
      value={count_label(@structures, @more?)}
      hint={window_label(@days, @windows)}
    />
  </div>
  
  <div :if={@tab == :spawns} class="grid grid-cols-2 lg:grid-cols-3 gap-3 mb-5">
    <.stat
      label={"Seen last #{fresh_window_label()}"}
      value={to_string(length(@fresh_spawns))}
      hint="latest per spawn"
      tone={if @fresh_spawns != [], do: :good, else: :neutral}
    />
    <.stat
      label="Sightings"
      value={count_label(@spawns, @more?)}
      hint={window_label(@days, @windows)}
    /> <.stat label="Richest sighting" value={isk(richest(@spawns))} />
  </div>
  
  <.panel_stack :if={@tab == :structures} id="scout-stack-structures">
    <%!-- CHEWY PATCH: the asset-safety trigger board, above Now.

          Every other board on this page reports what a sweep SAW. This
          one reports what EVE SAID: a `StructureItemsMovedToSafety`
          notification fires the instant a decommission completes, which
          is the instant the hull becomes loose. It is therefore the
          earliest and most precise lead on the page, and it is the only
          one that can report a structure no sweep has ever visited --
          which is why rows here may carry an id where every other board
          carries a name.

          Deliberately NOT folded into `now_rows/1`: these rows are a
          different shape (an event, not a structure's current state)
          and have no `last_confirmed_at`, `status` or presence to
          render in that table's columns. --%>
    <.panel
      :if={asset_safety_enabled?() and show_board?(@board, "asset_safety")}
      key="asset_safety"
      layout={@panel_layout}
      id="scout-asset-safety"
      title="Asset safety fired"
      count={length(@asset_safety_events)}
      tone={:urgent}
      class={@asset_safety_events != [] && "border-error/60 bg-error/5"}
      hint={"EVE told one of our characters its items left a structure — that structure finished unanchoring and is loose right now. Last #{asset_safety_horizon_days()}d, not the window selector."}
      copy="asset_safety"
      empty={@asset_safety_events == []}
      empty_text="nothing has finished unanchoring on us"
    >
      <.grid id="scout-asset-safety-table">
        <.table_head {head_attrs(assigns, "asset_safety")} />
        <tbody>
          <tr :for={row <- @asset_safety_events} id={"scout-asset-safety-#{row.id}"}>
            <td><.seen at={row.notified_at} now={@now} tone={true} /></td>
            
            <td>
              <span class="font-medium text-gray-100">
                {row.structure_name || to_string(row.structure_id)}
              </span>
              
              <span :if={row.group_name} class="ml-1 badge badge-sm border-neutral-700">
                {row.group_name}
              </span>
            </td>
            
            <td><.sys row={row} systems={@systems} /></td>
            
            <td class="text-gray-300">{row.owner_name || "—"}</td>
            
            <td class="text-xs text-gray-400">{where(row)}</td>
            
            <td class="text-xs text-gray-400">{row.character_name || "—"}</td>
            
            <td>
              <button
                phx-click="dismiss_asset_safety"
                phx-value-id={row.structure_id}
                class="btn btn-ghost btn-xs text-gray-600 hover:text-error"
                title="Dismiss — dealt with; takes this hull off the alert, the board and the badge"
              >
                ✕
              </button>
            </td>
          </tr>
        </tbody>
      </.grid>
      
      <:note>
        <.watcher_note watchers={@asset_safety_watchers} />
        <button
          :if={@asset_safety_watchers.count == 0}
          phx-click="request_notification_access"
          class="btn btn-xs btn-outline btn-warning"
        >
          Watch notifications
        </button>
      </:note>
    </.panel>
    
    <%!-- CHEWY PATCH: the undo list for the board above. Rendered only
          when non-empty and deliberately NOT window-bounded, like the
          structures' Archived board: a judgement you cannot find is a
          judgement you cannot reverse. --%>
    <.panel
      :if={
        asset_safety_enabled?() and show_board?(@board, "asset_safety") and
          @asset_safety_dismissed != []
      }
      key="asset_safety_dismissed"
      layout={@panel_layout}
      id="scout-asset-safety-dismissed"
      title="Dismissed asset safety"
      count={length(@asset_safety_dismissed)}
      hint="hidden from the alert and the board; ignores the window selector"
    >
      <.grid id="scout-asset-safety-dismissed-table">
        <.table_head {head_attrs(assigns, "asset_safety_dismissed")} />
        <tbody>
          <tr
            :for={row <- @asset_safety_dismissed}
            id={"scout-asset-safety-dismissed-#{row.id}"}
            class="opacity-60"
          >
            <td><.seen at={row.notified_at} now={@now} /></td>
            
            <td>
              <span class="font-medium text-gray-100">
                {row.structure_name || to_string(row.structure_id)}
              </span>
              
              <span :if={row.group_name} class="ml-1 badge badge-sm border-neutral-700">
                {row.group_name}
              </span>
            </td>
            
            <td><.sys row={row} systems={@systems} /></td>
            
            <td class="text-gray-300">{row.owner_name || "—"}</td>
            
            <td class="text-xs text-gray-400">{row.character_name || "—"}</td>
            
            <td>
              <button
                phx-click="restore_asset_safety"
                phx-value-id={row.structure_id}
                class="btn btn-ghost btn-xs text-gray-500 hover:text-warning"
                title="Restore — put this trigger back on the board"
              >
                ↺
              </button>
            </td>
          </tr>
        </tbody>
      </.grid>
    </.panel>
    
    <%!-- CHEWY PATCH: the lead. Not a read -- `now_rows/1` folds the
          three time-critical families out of rows this socket already
          holds, so it costs nothing and can never disagree with the
          boards below, where every one of these rows also appears. --%>
    <.panel
      :if={show_board?(@board, "now")}
      key="now"
      layout={@panel_layout}
      id="scout-now"
      title="Now"
      count={length(@now_board)}
      tone={:urgent}
      class={@now_board != [] && "border-error/60 bg-error/5"}
      hint={"unanchored, plus every deadline inside the #{now_horizon_label()} — all of it is on a board below too"}
      empty={@now_board == []}
      empty_text={"nothing to undock for in the #{now_horizon_label()}"}
    >
      <.grid id="scout-now-table">
        <.table_head {head_attrs(assigns, "now")} />
        <tbody>
          <tr :for={entry <- @now_board} id={"scout-now-#{entry.kind}-#{entry.row.id}"}>
            <td>
              <span :if={entry.kind == :unanchored} class="text-error font-semibold text-xs">
                sitting there
              </span>
               <.countdown_cell :if={entry.kind == :timer} expires_at={entry.at} now={@now} />
              <.predicted_out_cell :if={entry.kind == :unanchoring} row={entry.row} now={@now} />
            </td>
            
            <td>
              <span class={[
                "badge badge-sm border whitespace-nowrap",
                now_kind_class(entry.kind)
              ]}>
                {now_kind_label(entry.kind)}
              </span>
            </td>
            
            <td>
              <.subject
                name={entry.row.structure_name || to_string(entry.row.structure_id)}
                badge={entry.row.group_name}
                click="show_structure"
                phx-value-id={entry.row.structure_id}
              />
            </td>
            
            <td><.sys row={entry.row} systems={@systems} /></td>
            
            <td class="text-gray-300">{entry.row.owner_name || "—"}</td>
            
            <td><.status status={entry.row.status} vulnerable={entry.row.vulnerable} /></td>
            
            <td><.seen at={entry.row.last_confirmed_at} now={@now} /></td>
          </tr>
        </tbody>
      </.grid>
    </.panel>
    
    <.panel
      :if={show_board?(@board, "unanchored")}
      key="unanchored"
      layout={@panel_layout}
      title="Unanchored"
      count={length(@unanchored_structures)}
      tone={:urgent}
      class="border-error/60 bg-error/5"
      hint={"last #{unanchored_horizon_days()} days, not the window"}
      copy="unanchored"
      empty={@unanchored_structures == []}
      empty_text="nothing is sitting unanchored"
    >
      <.grid id="scout-unanchored">
        <.table_head {head_attrs(assigns, "unanchored")} />
        <tbody>
          <tr :for={row <- @unanchored_structures} id={"scout-unanchored-#{row.id}"}>
            <td>
              <.subject
                name={row.structure_name || to_string(row.structure_id)}
                badge={row.group_name}
                click="show_structure"
                phx-value-id={row.structure_id}
              />
            </td>
            
            <td><.sys row={row} systems={@systems} /></td>
            
            <td class="text-gray-300">{row.owner_name || "—"}</td>
            
            <td><.status status={row.status} vulnerable={row.vulnerable} /></td>
            
            <td class="text-xs text-gray-400">{where(row)}</td>
            
            <td><.seen at={row.last_confirmed_at} now={@now} /></td>
            
            <td><.archive_cell row={row} /></td>
          </tr>
        </tbody>
      </.grid>
    </.panel>
    
    <.panel
      :if={show_board?(@board, "timers")}
      key="timers"
      layout={@panel_layout}
      title="Live timers"
      count={length(@active_timers)}
      tone={if urgent_timers(@active_timers, @now) > 0, do: :urgent, else: :neutral}
      hint="ignores the window"
      copy="timers"
      empty={@active_timers == []}
      empty_text="no structure timer is running"
    >
      <.grid id="scout-active-timers">
        <.table_head {head_attrs(assigns, "timers")} />
        <tbody>
          <tr :for={row <- @active_timers} id={"scout-timer-#{row.id}"}>
            <td><.countdown_cell expires_at={row.timer_expires_at} now={@now} /></td>
            
            <td>
              <.subject
                name={row.structure_name || to_string(row.structure_id)}
                badge={row.group_name}
                meta={nearest_celestial_label(row)}
                click="show_structure"
                phx-value-id={row.structure_id}
              />
            </td>
            
            <td><.sys row={row} systems={@systems} /></td>
            
            <td class="text-gray-300">{row.owner_name || "—"}</td>
            
            <td><.status status={row.status} vulnerable={row.vulnerable} /></td>
            
            <td><.seen at={row.last_confirmed_at} now={@now} /></td>
            
            <td><.archive_cell row={row} /></td>
          </tr>
        </tbody>
      </.grid>
    </.panel>
    
    <.panel
      :if={show_board?(@board, "anchoring")}
      key="anchoring"
      layout={@panel_layout}
      title="Anchoring"
      count={length(@anchoring_structures)}
      tone={if @anchoring_structures != [], do: :warn, else: :neutral}
      hint="the anchoring clock the client reports; the window opens when it hits zero"
      copy="anchoring"
      empty={@anchoring_structures == []}
      empty_text="nothing anchoring right now"
    >
      <.grid id="scout-anchoring">
        <.table_head {head_attrs(assigns, "anchoring")} />
        <tbody>
          <tr :for={row <- @anchoring_structures} id={"scout-anchoring-#{row.id}"}>
            <td><.countdown_cell expires_at={row.timer_expires_at} now={@now} /></td>
            
            <td>
              <.subject
                name={row.structure_name || to_string(row.structure_id)}
                badge={row.group_name}
                click="show_structure"
                phx-value-id={row.structure_id}
              />
            </td>
            
            <td><.sys row={row} systems={@systems} /></td>
            
            <td class="text-gray-300">{row.owner_name || "—"}</td>
            
            <td><.status status={row.status} vulnerable={row.vulnerable} /></td>
            
            <td class="text-xs text-gray-400">{where(row)}</td>
            
            <td><.seen at={row.last_confirmed_at} now={@now} /></td>
            
            <td><.archive_cell row={row} /></td>
          </tr>
        </tbody>
      </.grid>
    </.panel>
    
    <%!-- CHEWY PATCH: the errand the Unanchoring board cannot express.

          The asset-safety trigger only fires for a structure we put
          something into, so an unseeded hull finishes unanchoring in
          SILENCE and looks identical, on every other board, to one that
          will report the instant it pops. This is that difference,
          rendered as the thing to go and do. "Armed" is read from ESI
          assets (`location_id == structure_id`), never from a checkbox:
          a checkbox is wrong the day somebody hauls the item back out
          and nobody notices. --%>
    <.panel
      :if={asset_safety_enabled?() and show_board?(@board, "unarmed")}
      key="unarmed"
      layout={@panel_layout}
      id="scout-unarmed"
      title="Needs seeding"
      count={length(@unarmed_structures)}
      tone={if @unarmed_structures != [], do: :warn, else: :neutral}
      hint="unanchoring, with nothing of ours inside — drop one item in each and EVE will tell us the moment it comes out"
      copy="unarmed"
      empty={@unarmed_structures == []}
      empty_text="every unanchoring structure we can see is armed"
    >
      <.grid id="scout-unarmed-table">
        <.table_head {head_attrs(assigns, "unarmed")} />
        <tbody>
          <tr :for={row <- @unarmed_structures} id={"scout-unarmed-#{row.id}"}>
            <td><.predicted_out_cell row={row} now={@now} /></td>
            
            <td>
              <.subject
                name={row.structure_name || to_string(row.structure_id)}
                badge={row.group_name}
                click="show_structure"
                phx-value-id={row.structure_id}
              />
            </td>
            
            <td><.sys row={row} systems={@systems} /></td>
            
            <td class="text-gray-300">{row.owner_name || "—"}</td>
            
            <td class="text-xs text-gray-400">{where(row)}</td>
            
            <td><.seen at={row.last_confirmed_at} now={@now} /></td>
          </tr>
        </tbody>
      </.grid>
      
      <%!-- Same note as the trigger board: with nobody consented,
            "armed" is unknowable and every hull reads as needing an
            item. --%>
      <:note>
        <.watcher_note watchers={@asset_safety_watchers} />
      </:note>
    </.panel>
    
    <.panel
      :if={show_board?(@board, "unanchoring")}
      key="unanchoring"
      layout={@panel_layout}
      title="Unanchoring"
      count={length(@unanchoring_structures)}
      tone={if @unanchoring_structures != [], do: :warn, else: :neutral}
      hint="a decommission reports no timer; the deadline is the fixed 7-day window from the first sweep that saw it"
      copy="unanchoring"
      empty={@unanchoring_structures == []}
      empty_text="nothing unanchoring right now"
    >
      <.grid id="scout-unanchoring">
        <.table_head {head_attrs(assigns, "unanchoring")} />
        <tbody>
          <tr :for={row <- @unanchoring_structures} id={"scout-unanchoring-#{row.id}"}>
            <td><.predicted_out_cell row={row} now={@now} /></td>
            
            <td>
              <.subject
                name={row.structure_name || to_string(row.structure_id)}
                badge={row.group_name}
                click="show_structure"
                phx-value-id={row.structure_id}
              />
            </td>
            
            <td><.sys row={row} systems={@systems} /></td>
            
            <td class="text-gray-300">{row.owner_name || "—"}</td>
            
            <td><.status status={row.status} vulnerable={row.vulnerable} /></td>
            
            <td :if={asset_safety_enabled?()}>
              <.armed_cell row={row} armed_by={@armed_by} />
            </td>
            
            <td class="text-xs text-gray-400">{where(row)}</td>
            
            <td><.seen at={row.last_confirmed_at} now={@now} /></td>
            
            <td><.archive_cell row={row} /></td>
          </tr>
        </tbody>
      </.grid>
    </.panel>
    
    <%!-- CHEWY PATCH: the endings. An unanchoring run is the one finding
          on this page with a fixed lifetime, and until now it left the
          Unanchoring board by simply disappearing -- the row went
          `:gone`, or a steady id cleared it, or its 7 days quietly ran
          out, and the page said nothing. "Nobody got it and it is over"
          and "we are still waiting" looked identical.

          Everything here is somebody else's work: the owner stopped the
          decommission, a third party reinforced it, or the hull was
          collected between two of our visits. `:unanchored` endings are
          NOT on this board -- that hull is loose, and it is on the red
          alert above. --%>
    <.panel
      :if={show_board?(@board, "sorted")}
      key="sorted"
      layout={@panel_layout}
      id="scout-sorted"
      title="Someone else sorted it"
      count={length(@sorted_structures)}
      tone={:neutral}
      hint="unanchoring runs that ended without a hull for us — stopped, gone when we next looked, or past their 7 days"
      copy="sorted"
      empty={@sorted_structures == []}
      empty_text="no unanchoring run has ended in this window"
    >
      <.grid id="scout-sorted-table">
        <.table_head {head_attrs(assigns, "sorted")} />
        <tbody>
          <tr :for={row <- @sorted_structures} id={"scout-sorted-#{row.id}"}>
            <td><.ended_cell row={row} now={@now} /></td>
            
            <td><.outcome_cell row={row} now={@now} /></td>
            
            <td>
              <.subject
                name={row.structure_name || to_string(row.structure_id)}
                badge={row.group_name}
                click="show_structure"
                phx-value-id={row.structure_id}
              />
            </td>
            
            <td><.sys row={row} systems={@systems} /></td>
            
            <td class="text-gray-300">{row.owner_name || "—"}</td>
            
            <td class="text-xs text-gray-400">{where(row)}</td>
            
            <td><.seen at={row.last_confirmed_at} now={@now} /></td>
            
            <td><.archive_cell row={row} /></td>
          </tr>
        </tbody>
      </.grid>
    </.panel>
    
    <.panel
      :if={show_board?(@board, "abandoned")}
      key="abandoned"
      layout={@panel_layout}
      title="Abandoned"
      count={length(@abandoned_structures)}
      tone={if @abandoned_structures != [], do: :good, else: :neutral}
      hint="asset safety off — everything inside drops"
      copy="abandoned"
      empty={@abandoned_structures == []}
      empty_text="nothing abandoned in this window"
    >
      <.grid id="scout-abandoned">
        <.table_head {head_attrs(assigns, "abandoned")} />
        <tbody>
          <tr :for={row <- @abandoned_structures} id={"scout-abandoned-#{row.id}"}>
            <td>
              <.subject
                name={row.structure_name || to_string(row.structure_id)}
                badge={row.group_name}
                click="show_structure"
                phx-value-id={row.structure_id}
              />
            </td>
            
            <td><.sys row={row} systems={@systems} /></td>
            
            <td class="text-gray-300">{row.owner_name || "—"}</td>
            
            <td><.status status={row.status} vulnerable={row.vulnerable} /></td>
            
            <td class="text-xs text-gray-400">{where(row)}</td>
            
            <td><.seen at={row.last_confirmed_at} now={@now} /></td>
            
            <td><.archive_cell row={row} /></td>
          </tr>
        </tbody>
      </.grid>
    </.panel>
    
    <%!-- CHEWY PATCH: its own board since 1.103.4-chewy.86. `NoFuel` and
          `Abandoned` shared one through `Status.dead_family/0`, and they
          are not the same errand: an abandoned hull is loot now, an
          unfuelled one is an owner who stopped paying and may yet come
          back. One table meant reading the status column row by row to
          tell which was which. --%>
    <.panel
      :if={show_board?(@board, "no_fuel")}
      key="no_fuel"
      layout={@panel_layout}
      title="No fuel"
      count={length(@no_fuel_structures)}
      tone={if @no_fuel_structures != [], do: :good, else: :neutral}
      hint="low power — no tether, no services"
      copy="no_fuel"
      empty={@no_fuel_structures == []}
      empty_text="nothing unfuelled in this window"
    >
      <.grid id="scout-no-fuel">
        <.table_head {head_attrs(assigns, "no_fuel")} />
        <tbody>
          <tr :for={row <- @no_fuel_structures} id={"scout-no-fuel-#{row.id}"}>
            <td>
              <.subject
                name={row.structure_name || to_string(row.structure_id)}
                badge={row.group_name}
                click="show_structure"
                phx-value-id={row.structure_id}
              />
            </td>
            
            <td><.sys row={row} systems={@systems} /></td>
            
            <td class="text-gray-300">{row.owner_name || "—"}</td>
            
            <td><.status status={row.status} vulnerable={row.vulnerable} /></td>
            
            <td class="text-xs text-gray-400">{where(row)}</td>
            
            <td><.seen at={row.last_confirmed_at} now={@now} /></td>
            
            <td><.archive_cell row={row} /></td>
          </tr>
        </tbody>
      </.grid>
    </.panel>
    
    <%!-- CHEWY PATCH: what a reader took off the boards by hand. Only
          rendered when there is something to undo, and deliberately not
          bounded by the window selector -- an archive that aged out of
          the window would be unrecoverable from this page. --%>
    <.panel
      :if={show_board?(@board, "archived") and @archived_structures != []}
      key="archived"
      layout={@panel_layout}
      title="Archived"
      count={length(@archived_structures)}
      hint="hidden from the boards until the feed reports a change; ignores the window"
    >
      <.grid id="scout-archived">
        <.table_head {head_attrs(assigns, "archived")} />
        <tbody>
          <tr
            :for={row <- @archived_structures}
            id={"scout-archived-#{row.id}"}
            class="opacity-60"
          >
            <td>
              <.subject
                name={row.structure_name || to_string(row.structure_id)}
                badge={row.group_name}
                meta={nearest_celestial_label(row)}
                click="show_structure"
                phx-value-id={row.structure_id}
              />
            </td>
            
            <td><.sys row={row} systems={@systems} /></td>
            
            <td class="text-gray-300">{row.owner_name || "—"}</td>
            
            <td><.status status={row.status} vulnerable={row.vulnerable} /></td>
            
            <td><.seen at={row.archived_at} now={@now} /></td>
            
            <td><.seen at={row.last_confirmed_at} now={@now} /></td>
            
            <td><.archive_cell row={row} /></td>
          </tr>
        </tbody>
      </.grid>
    </.panel>
    
    <.log_panel
      :if={show_board?(@board, "log")}
      key="log"
      layout={@panel_layout}
      id="scout-structure-log"
      title="Ingest log · structures"
      count={count_label(@structures, @more?)}
      hint="every structure reported in this window, latest report per structure"
    >
      <.grid id="scout-structures">
        <.table_head {head_attrs(assigns, "structures")} />
        <tbody>
          <tr :for={row <- @structures} id={"scout-structure-#{row.id}"}>
            <td>
              <.subject
                name={row.structure_name || to_string(row.structure_id)}
                badge={row.group_name}
                meta={nearest_celestial_label(row)}
                click="show_structure"
                phx-value-id={row.structure_id}
              />
            </td>
            
            <td><.sys row={row} systems={@systems} /></td>
            
            <td class="text-gray-300">{row.owner_name || "—"}</td>
            
            <td><.status status={row.status} vulnerable={row.vulnerable} /></td>
            
            <td><.countdown_cell expires_at={row.timer_expires_at} now={@now} /></td>
            
            <td><.seen at={row.last_confirmed_at} now={@now} /></td>
            
            <td><.archive_cell row={row} /></td>
          </tr>
          
          <.empty :if={@structures == []} cols={7}>
            <span :if={@totals && @totals.structures == 0}>
              No structure has ever been reported — no scanner client has posted to
              <code class="text-gray-400">/api/maps/:map/scout/structures</code>
              yet.
            </span>
            
            <span :if={is_nil(@totals) || @totals.structures > 0}>
              No structure matches this window and filter.
            </span>
          </.empty>
        </tbody>
      </.grid>
    </.log_panel>
  </.panel_stack>
  
  <.panel_stack :if={@tab == :spawns} id="scout-stack-spawns">
    <.panel
      key="fresh_spawns"
      layout={@panel_layout}
      title={"Seen in the last #{fresh_window_label()}"}
      count={length(@fresh_spawns)}
      tone={if @fresh_spawns != [], do: :good, else: :neutral}
      hint="latest sighting per spawn, ignores the window selector"
      copy="spawns"
    >
      <.grid id="scout-fresh-spawns">
        <.table_head {head_attrs(assigns, "fresh_spawns")} />
        <tbody>
          <tr :for={row <- @fresh_spawns} id={"scout-fresh-spawn-#{row.id}"}>
            <td><.seen at={row.observed_at} now={@now} tone /></td>
            
            <td>
              <.subject
                name={row.spawn_name}
                badge={row.spawn_category}
                meta={row.anomaly_type}
                click="show_spawn"
                phx-value-system={row.solar_system_id}
                phx-value-location={row.location_name}
                phx-value-spawn={row.spawn_name}
              />
            </td>
            
            <td><.sys row={row} systems={@systems} /></td>
            
            <td class="text-gray-400 text-xs">
              {row.location_name}
              <span :if={row.location_type} class="text-gray-600">· {row.location_type}</span>
            </td>
            
            <td class="font-mono tabular-nums text-right">{row.players_in_local}</td>
            
            <td class="font-mono tabular-nums text-right whitespace-nowrap">
              {isk(row.isk_value)}
            </td>
          </tr>
          
          <.empty :if={@fresh_spawns == []} cols={6}>
            Nothing spawned in the last {fresh_window_label()}.
          </.empty>
        </tbody>
      </.grid>
    </.panel>
    
    <.log_panel
      key="spawn_log"
      layout={@panel_layout}
      id="scout-spawn-log"
      title="Ingest log · spawns"
      count={count_label(@spawns, @more?)}
      hint="every sighting reported in this window"
    >
      <.grid id="scout-spawns">
        <.table_head {head_attrs(assigns, "spawns")} />
        <tbody>
          <tr :for={row <- @spawns} id={"scout-spawn-#{row.id}"}>
            <td><.seen at={row.observed_at} now={@now} /></td>
            
            <td>
              <.subject
                name={row.spawn_name}
                badge={row.spawn_category}
                meta={row.anomaly_type}
                click="show_spawn"
                phx-value-system={row.solar_system_id}
                phx-value-location={row.location_name}
                phx-value-spawn={row.spawn_name}
              />
            </td>
            
            <td><.sys row={row} systems={@systems} /></td>
            
            <td class="text-gray-400 text-xs">
              {row.location_name}
              <span :if={row.location_type} class="text-gray-600">· {row.location_type}</span>
            </td>
            
            <td class="font-mono tabular-nums text-right">{row.players_in_local}</td>
            
            <td class="font-mono tabular-nums text-right text-gray-500">
              {if row.minutes_since_downtime, do: "#{row.minutes_since_downtime}m", else: "—"}
            </td>
            
            <td class="text-gray-400 text-xs">{row.outcome || row.action_taken || "—"}</td>
            
            <td class="font-mono tabular-nums text-right whitespace-nowrap">
              {isk(row.isk_value)}
            </td>
          </tr>
          
          <.empty :if={@spawns == []} cols={8}>
            <span :if={@totals && @totals.spawns == 0}>
              No spawn has ever been reported — no scanner client has posted to
              <code class="text-gray-400">/api/maps/:map/scout/spawns</code>
              yet.
            </span>
            
            <span :if={is_nil(@totals) || @totals.spawns > 0}>
              No spawn matches this window and filter.
            </span>
          </.empty>
        </tbody>
      </.grid>
    </.log_panel>
  </.panel_stack>
   <%!-- It pages the ingest log and nothing else, so it follows it. --%>
  <div
    :if={@more? and show_board?(@board, "log")}
    class="flex items-center gap-3 mb-6"
    id="scout-more"
  >
    <button phx-click="load_more" class="btn btn-sm">Load more</button>
    <span class="text-xs text-gray-500">first {@limit} rows</span>
  </div>
  
  <div
    :if={@detail}
    class="modal modal-open !bg-black/70"
    id="scout-structure-detail"
    phx-window-keydown="close_structure"
    phx-key="Escape"
  >
    <div class="modal-box max-w-5xl max-h-[80vh] overflow-y-auto bg-neutral-900 border border-neutral-800 p-0">
      <div class="flex items-start justify-between gap-4 px-4 py-3 border-b border-neutral-800 sticky top-0 bg-neutral-900 z-10">
        <div class="min-w-0">
          <h3 class="font-semibold truncate">
            {(@detail.structure || %{}) |> Map.get(:structure_name) || @detail.structure_id}
          </h3>
          
          <p class="text-xs text-gray-500">
            {plural(length(@detail.rows), "event", "events")} · {@detail.structure_id}
            <span :if={@detail.structure}>· {@detail.structure.presence}</span>
            <span :if={nearest_celestial_label(@detail.structure)}>
              · {nearest_celestial_label(@detail.structure)}
            </span>
          </p>
        </div>
         <button phx-click="close_structure" class="btn btn-sm btn-ghost">✕</button>
      </div>
      
      <div class="overflow-x-auto">
        <.grid id="scout-structure-history">
          <.table_head {head_attrs(assigns, "structure_history")} />
          <tbody>
            <tr :for={row <- @detail.rows} id={"scout-history-#{row.id}"}>
              <td><.seen at={row.observed_at} now={@now} /></td>
              
              <td>
                <span class={[
                  "badge badge-sm border",
                  row.kind in [:gone, :missing] && "bg-error/15 border-error/40 text-error",
                  row.kind == :changed && "bg-warning/15 border-warning/40 text-warning",
                  row.kind in [:appeared, :cleared] &&
                    "bg-transparent border-neutral-700 text-gray-500"
                ]}>
                  {row.kind}
                </span>
              </td>
              
              <td><.sys row={row} systems={@systems} /></td>
              
              <td class="text-xs text-gray-300">
                <span :if={row.status_before}>{row.status_before} →</span> {row.status_after ||
                  "—"}
              </td>
              
              <td class="text-xs text-gray-500">
                {Enum.join(row.changed_fields || [], ", ")}
              </td>
            </tr>
            
            <.empty :if={@detail.rows == []} cols={5}>
              Nothing has happened to this structure yet.
            </.empty>
          </tbody>
        </.grid>
      </div>
    </div>
     <button class="modal-backdrop" phx-click="close_structure">close</button>
  </div>
  
  <div
    :if={@spawn_detail}
    class="modal modal-open !bg-black/70"
    id="scout-spawn-detail"
    phx-window-keydown="close_spawn"
    phx-key="Escape"
  >
    <div class="modal-box max-w-5xl max-h-[80vh] overflow-y-auto bg-neutral-900 border border-neutral-800 p-0">
      <div class="flex items-start justify-between gap-4 px-4 py-3 border-b border-neutral-800 sticky top-0 bg-neutral-900 z-10">
        <div class="min-w-0">
          <h3 class="font-semibold truncate">{@spawn_detail.spawn_name}</h3>
          
          <p class="text-xs text-gray-500 truncate">
            {plural(length(@spawn_detail.rows), "sighting", "sightings")} · {@spawn_detail.location_name} · {system(
              Map.put(@spawn_detail, :solar_system_name, nil),
              @systems
            )}
            <span :if={region(@spawn_detail, @systems)}>
              · {region(@spawn_detail, @systems)}
            </span>
          </p>
        </div>
         <button phx-click="close_spawn" class="btn btn-sm btn-ghost">✕</button>
      </div>
      
      <div class="overflow-x-auto">
        <.grid id="scout-spawn-history">
          <.table_head {head_attrs(assigns, "spawn_history")} />
          <tbody>
            <tr :for={row <- @spawn_detail.rows} id={"scout-spawn-history-#{row.id}"}>
              <td><.seen at={row.observed_at} now={@now} /></td>
              
              <td><.sys row={row} systems={@systems} /></td>
              
              <td class="text-gray-400 text-xs">{row.location_name}</td>
              
              <td class="font-mono tabular-nums text-right">{row.players_in_local}</td>
              
              <td class="font-mono tabular-nums text-right text-gray-500">
                {if row.minutes_since_downtime, do: "#{row.minutes_since_downtime}m", else: "—"}
              </td>
              
              <td class="text-gray-400 text-xs">{row.outcome || row.action_taken || "—"}</td>
              
              <td class="font-mono tabular-nums text-right whitespace-nowrap">
                {isk(row.isk_value)}
              </td>
            </tr>
            
            <.empty :if={@spawn_detail.rows == []} cols={7}>No history for this spawn.</.empty>
          </tbody>
        </.grid>
      </div>
    </div>
     <button class="modal-backdrop" phx-click="close_spawn">close</button>
  </div>
  
  <%!-- CHEWY PATCH: the paste boxes. Discord renders `<t:…:R>` as a live
        countdown in each reader's own timezone, which is the whole
        reason this is a message rather than a screenshot. One box per
        Discord-sized message, nothing dropped, and nothing written to
        the clipboard on the reader's behalf: select a box, copy it,
        paste it, repeat. --%>
  <div
    :if={@discord}
    class="modal modal-open !bg-black/70"
    id="scout-discord"
    phx-window-keydown="close_discord"
    phx-key="Escape"
  >
    <div class="modal-box max-w-3xl bg-neutral-900 border border-neutral-800 p-0">
      <div class="flex items-start justify-between gap-4 px-4 py-3 border-b border-neutral-800">
        <div class="min-w-0">
          <h3 class="font-semibold truncate">{@discord.title} · Discord</h3>
          
          <p class="text-xs text-gray-500">
            {@discord.total} rows · {length(@discord.parts)} {if length(@discord.parts) == 1,
              do: "message",
              else: "messages, paste them in order"} · timers stay live once pasted
          </p>
        </div>
         <button phx-click="close_discord" class="btn btn-sm btn-ghost">✕</button>
      </div>
      
      <div class="p-4 space-y-4 max-h-[70vh] overflow-auto">
        <div :for={{part, index} <- Enum.with_index(@discord.parts, 1)} class="space-y-1">
          <div class="flex items-baseline justify-between gap-2 text-xs text-gray-500">
            <span class="font-mono">
              Message {index}/{length(@discord.parts)}
            </span>
             <span>{String.length(part)}/{discord_limit()} characters</span>
          </div>
           <textarea
            id={"scout-discord-part-#{index}"}
            readonly
            rows="12"
            class="textarea textarea-bordered w-full bg-neutral-950/60 font-mono text-xs leading-relaxed"
            onfocus="this.select()"
            onclick="this.select()"
          ><%= part %></textarea>
        </div>
        
        <p class="text-xs text-gray-500">
          Click a box to select it, then copy. Paste as-is — Discord renders the times in each reader's own timezone.
        </p>
      </div>
    </div>
     <button class="modal-backdrop" phx-click="close_discord">close</button>
  </div>
  
  <%!-- CHEWY PATCH: the planner, nested rather than routed (router.ex,
        ScoutIntelLive.handle_params/3). Mounted lazily on first visit to
        `/scout/planner` and then NEVER unmounted -- a parent-owned
        wrapper div toggles `hidden` instead of the live_render
        `container:` option, since morphdom does not reliably patch an
        attribute-only change on a phx-child container. This parent
        LiveView never remounts across a patch (category switches are
        `push_patch`, not a navigate), so the child does not need
        `sticky: true` either -- its own id in the DOM is enough. --%>
  <div :if={@planner_mounted?} id="scout-planner-pane" class={@tab != :planner && "hidden"}>
    <%!-- `container:` is NOT optional here. `WandererAppWeb.live_view/1`
          defaults EVERY LiveView's container to the ROOT page shell's
          classes (`relative h-screen flex overflow-hidden bg-white`),
          which is right for a routed page and ruinous for a child: it
          dropped a white, viewport-tall flex row in the middle of this
          page and the planner rendered as a squeezed column on a white
          slab. `{:div, class: ""}` is the same thing the layout already
          does for its nested `ServerStatusLive`. --%> {live_render(
      @socket,
      WandererAppWeb.ScoutPlannerLive,
      id: "scout-planner-live",
      session: %{"user_id" => @current_user.id},
      container: {:div, class: ""}
    )}
  </div>
</main>
