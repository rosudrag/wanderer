<main class="w-full h-full p-4 pl-20 pb-20 overflow-auto text-gray-200">
  <h1 class="text-2xl font-semibold mb-2">Your Identity</h1>
  <p class="mb-6 text-gray-400">
    State is computed from your designated <strong>main</strong> character only —
    never an alt.
  </p>

  <div class="mb-6">
    <span class="text-gray-400">Current state:</span>
    <span class="badge badge-lg ml-2" id="corp-identity-state">{@state}</span>
  </div>

  <table class="table w-full" id="corp-identity-characters">
    <thead>
      <tr>
        <th>Character</th>
        <th>Corporation</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <tr :for={character <- @characters} id={"character-row-#{character.id}"}>
        <td>{character.name}</td>
        <td>{character.corporation_name || "-"}</td>
        <td class="text-right">
          <span :if={character.id == @main_character_id} class="badge badge-primary">
            Main
          </span>
          <button
            :if={character.id != @main_character_id}
            type="button"
            class="btn btn-xs"
            phx-click="set_main"
            phx-value-character_id={character.id}
          >
            Set as main
          </button>
        </td>
      </tr>
    </tbody>
  </table>
</main>
