<div class="p-8 text-gray-200">
  <h1 class="text-2xl font-semibold mb-4">Corp</h1>
  <p class="mb-4 text-gray-400">
    The alliance identity suite. Start by setting your main character.
  </p>
  <.link navigate={~p"/corp/identity"} class="btn btn-sm">
    Your identity
  </.link>
  <.link
    :if={@corp_flags[:group_map_sync_enabled?] and @current_user_role == :admin}
    navigate={~p"/corp/map-grants"}
    class="btn btn-sm"
  >
    Map access grants
  </.link>
  <.link :if={@corp_flags[:corp_roster_enabled?]} navigate={~p"/corp/roster"} class="btn btn-sm">
    Corp roster
  </.link>
</div>
