<main class="w-full h-full p-4 pl-20 pb-20 overflow-auto text-gray-200">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-3">
    <h1 class="text-xl font-semibold tracking-tight">Scout Log</h1>

    <span
      class="flex items-center gap-1.5 text-[11px] text-gray-500"
      title="New reports appear without a reload"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-success"></span> live
    </span>

    <span class="text-[11px] text-gray-500 whitespace-nowrap" title="Is the scanner client alive?">
      structures <span class="text-gray-300">{ago(@last_observed.structures, @now)}</span>
      · spawns <span class="text-gray-300">{ago(@last_observed.spawns, @now)}</span>
      · times UTC
    </span>

    <div class="ml-auto flex items-center gap-2">
      <a
        href={export_path(assigns)}
        class="btn btn-sm btn-ghost"
        download
        title="The rows below, every stored column, as CSV"
      >
        Export CSV
      </a>
      <button phx-click="refresh" class="btn btn-sm btn-ghost">Refresh</button>
      <.link :if={@can_manage_access?} navigate={~p"/scout/access"} class="btn btn-sm">
        Manage access
      </.link>
    </div>
  </div>

  <.unanchored_alert
    rows={@unanchored_structures}
    systems={@systems}
    now={@now}
    horizon_days={unanchored_horizon_days()}
  />

  <div class="flex flex-wrap items-center gap-2 mb-4 p-2 rounded-lg border border-neutral-800 bg-neutral-900/30">
    <div role="tablist" class="tabs tabs-boxed tabs-sm bg-neutral-950/60">
      <button
        role="tab"
        id="scout-tab-structures"
        phx-click="select_tab"
        phx-value-tab="structures"
        class={["tab", @tab == :structures && "tab-active"]}
      >
        Structures
      </button>
      <button
        role="tab"
        id="scout-tab-spawns"
        phx-click="select_tab"
        phx-value-tab="spawns"
        class={["tab", @tab == :spawns && "tab-active"]}
      >
        Spawns
      </button>
    </div>

    <form phx-change="select_window">
      <select
        name="days"
        id="scout-window"
        title="Window — the log tables below are bounded by this"
        class="select select-sm select-bordered bg-neutral-950/60 w-32 py-0"
      >
        <option :for={{label, days} <- @windows} value={days} selected={days == @days}>
          Last {label}
        </option>
      </select>
    </form>

    <form phx-change="search" class="grow min-w-[180px] max-w-sm">
      <input
        type="text"
        name="q"
        id="scout-search"
        value={@q}
        phx-debounce="300"
        autocomplete="off"
        placeholder={
          if @tab == :structures,
            do: "Search structure, owner, system, type…",
            else: "Search spawn, belt, system, category…"
        }
        class="input input-sm input-bordered w-full bg-neutral-950/60"
      />
    </form>

    <div class="join" id="scout-space-filter">
      <.space_chip
        :for={{key, label} <- @space_types}
        key={key}
        label={label}
        selected={key in @space}
      />
    </div>

    <button
      :if={@system_id}
      phx-click="clear_system"
      id="scout-system-filter"
      class="btn btn-sm btn-outline btn-warning gap-1"
      title="Clear the system filter"
    >
      {system(%{solar_system_id: @system_id, solar_system_name: nil}, @systems)} ✕
    </button>

    <button
      :if={length(@space) < length(@space_types)}
      phx-click="reset_space"
      id="scout-space-reset"
      class="btn btn-sm btn-ghost text-gray-400"
      title="Select every space type again"
    >
      All space ✕
    </button>
  </div>

  <div :if={@tab == :structures} class="grid grid-cols-2 lg:grid-cols-5 gap-3 mb-5">
    <.stat
      id="scout-stat-unanchored"
      label="Unanchored"
      value={to_string(length(@unanchored_structures))}
      hint={"last #{unanchored_horizon_days()}d"}
      tone={if @unanchored_structures != [], do: :urgent, else: :neutral}
    />
    <.stat
      label="Timers running"
      value={to_string(length(@active_timers))}
      hint={timer_hint(@active_timers, @now)}
      tone={if urgent_timers(@active_timers, @now) > 0, do: :urgent, else: :neutral}
    />
    <.stat
      label="Anchoring"
      value={to_string(length(@anchoring_structures))}
      tone={if @anchoring_structures != [], do: :warn, else: :neutral}
    />
    <.stat
      label="Unanchoring"
      value={to_string(length(@unanchoring_structures))}
      tone={if @unanchoring_structures != [], do: :warn, else: :neutral}
    />
    <.stat
      label="Structures seen"
      value={count_label(@structures, @more?)}
      hint={window_label(@days, @windows)}
    />
  </div>

  <div :if={@tab == :spawns} class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5">
    <.stat
      label="Still out there"
      value={to_string(length(@fresh_spawns))}
      hint={"last #{fresh_window_label()}"}
      tone={if @fresh_spawns != [], do: :good, else: :neutral}
    />
    <.stat
      label="Sightings"
      value={count_label(@spawns, @more?)}
      hint={window_label(@days, @windows)}
    />
    <.stat label="Hotspots" value={to_string(length(@hotspots))} />
    <.stat label="Richest sighting" value={isk(richest(@spawns))} />
  </div>

  <div :if={@tab == :structures}>
    <.panel
      :if={@unanchored_structures != []}
      title="Unanchored"
      count={length(@unanchored_structures)}
      tone={:urgent}
      class="border-error/60 bg-error/5"
      hint={"last #{unanchored_horizon_days()} days, not the window"}
    >
      <.grid id="scout-unanchored">
        <thead>
          <tr>
            <th>Structure</th>
            <th>System</th>
            <th>Owner</th>
            <th>Status</th>
            <th class="w-36">Shield / Armor / Hull</th>
            <th>Where</th>
            <th class="w-32">Seen</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={row <- @unanchored_structures} id={"scout-unanchored-#{row.id}"}>
            <td>
              <.subject
                name={row.structure_name || to_string(row.structure_id)}
                badge={row.group_name}
                meta={nearest_celestial_label(row)}
                click="show_structure"
                phx-value-id={row.structure_id}
              />
            </td>
            <td><.sys row={row} systems={@systems} /></td>
            <td class="text-gray-300">{row.owner_name || "—"}</td>
            <td><.status status={row.status} vulnerable={row.vulnerable} /></td>
            <td class="font-mono text-xs tabular-nums whitespace-nowrap">{hp_label(row)}</td>
            <td class="text-xs text-gray-400">{distance_or_celestial(row)}</td>
            <td><.seen at={row.observed_at} now={@now} /></td>
          </tr>
        </tbody>
      </.grid>
    </.panel>

    <.panel
      title="Live timers"
      count={length(@active_timers)}
      tone={if urgent_timers(@active_timers, @now) > 0, do: :urgent, else: :neutral}
      hint="ignores the window"
    >
      <.grid id="scout-active-timers">
        <thead>
          <tr>
            <th class="w-28">Comes out</th>
            <th>Structure</th>
            <th>System</th>
            <th>Owner</th>
            <th>Status</th>
            <th class="w-32">Seen</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={row <- @active_timers} id={"scout-timer-#{row.id}"}>
            <td><.countdown_cell expires_at={row.timer_expires_at} now={@now} /></td>
            <td>
              <.subject
                name={row.structure_name || to_string(row.structure_id)}
                badge={row.group_name}
                meta={nearest_celestial_label(row)}
                click="show_structure"
                phx-value-id={row.structure_id}
              />
            </td>
            <td><.sys row={row} systems={@systems} /></td>
            <td class="text-gray-300">{row.owner_name || "—"}</td>
            <td><.status status={row.status} vulnerable={row.vulnerable} /></td>
            <td><.seen at={row.observed_at} now={@now} /></td>
          </tr>
          <.empty :if={@active_timers == []} cols={6}>No structure timer is running.</.empty>
        </tbody>
      </.grid>
    </.panel>

    <.panel
      title="Anchoring"
      count={length(@anchoring_structures)}
      tone={if @anchoring_structures != [], do: :warn, else: :neutral}
    >
      <.grid id="scout-anchoring">
        <thead>
          <tr>
            <th>Structure</th>
            <th>System</th>
            <th>Owner</th>
            <th>Status</th>
            <th class="w-36">Shield / Armor / Hull</th>
            <th>Where</th>
            <th class="w-32">Seen</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={row <- @anchoring_structures} id={"scout-anchoring-#{row.id}"}>
            <td>
              <.subject
                name={row.structure_name || to_string(row.structure_id)}
                badge={row.group_name}
                click="show_structure"
                phx-value-id={row.structure_id}
              />
            </td>
            <td><.sys row={row} systems={@systems} /></td>
            <td class="text-gray-300">{row.owner_name || "—"}</td>
            <td><.status status={row.status} vulnerable={row.vulnerable} /></td>
            <td class="font-mono text-xs tabular-nums whitespace-nowrap">{hp_label(row)}</td>
            <td class="text-xs text-gray-400">{distance_or_celestial(row)}</td>
            <td><.seen at={row.observed_at} now={@now} /></td>
          </tr>
          <.empty :if={@anchoring_structures == []} cols={7}>
            Nothing anchoring right now.
          </.empty>
        </tbody>
      </.grid>
    </.panel>

    <.panel
      title="Unanchoring"
      count={length(@unanchoring_structures)}
      tone={if @unanchoring_structures != [], do: :warn, else: :neutral}
    >
      <.grid id="scout-unanchoring">
        <thead>
          <tr>
            <th class="w-28">Comes out</th>
            <th>Structure</th>
            <th>System</th>
            <th>Owner</th>
            <th>Status</th>
            <th class="w-36">Shield / Armor / Hull</th>
            <th>Where</th>
            <th class="w-32">Seen</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={row <- @unanchoring_structures} id={"scout-unanchoring-#{row.id}"}>
            <td><.countdown_cell expires_at={row.timer_expires_at} now={@now} /></td>
            <td>
              <.subject
                name={row.structure_name || to_string(row.structure_id)}
                badge={row.group_name}
                click="show_structure"
                phx-value-id={row.structure_id}
              />
            </td>
            <td><.sys row={row} systems={@systems} /></td>
            <td class="text-gray-300">{row.owner_name || "—"}</td>
            <td><.status status={row.status} vulnerable={row.vulnerable} /></td>
            <td class="font-mono text-xs tabular-nums whitespace-nowrap">{hp_label(row)}</td>
            <td class="text-xs text-gray-400">{distance_or_celestial(row)}</td>
            <td><.seen at={row.observed_at} now={@now} /></td>
          </tr>
          <.empty :if={@unanchoring_structures == []} cols={8}>
            Nothing unanchoring right now.
          </.empty>
        </tbody>
      </.grid>
    </.panel>

    <.panel
      title="Last seen"
      count={count_label(@structures, @more?)}
      hint="latest report per structure"
    >
      <.grid id="scout-structures">
        <thead>
          <tr>
            <th>Structure</th>
            <th>System</th>
            <th>Owner</th>
            <th>Status</th>
            <th class="w-28">Comes out</th>
            <th class="w-32">Seen</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={row <- @structures} id={"scout-structure-#{row.id}"}>
            <td>
              <.subject
                name={row.structure_name || to_string(row.structure_id)}
                badge={row.group_name}
                meta={nearest_celestial_label(row)}
                click="show_structure"
                phx-value-id={row.structure_id}
              />
            </td>
            <td><.sys row={row} systems={@systems} /></td>
            <td class="text-gray-300">{row.owner_name || "—"}</td>
            <td><.status status={row.status} vulnerable={row.vulnerable} /></td>
            <td><.countdown_cell expires_at={row.timer_expires_at} now={@now} /></td>
            <td><.seen at={row.observed_at} now={@now} /></td>
          </tr>
          <.empty :if={@structures == []} cols={6}>
            <span :if={@totals && @totals.structures == 0}>
              No structure has ever been reported — no scanner client has posted to
              <code class="text-gray-400">/api/maps/:map/scout/structures</code>
              yet.
            </span>
            <span :if={is_nil(@totals) || @totals.structures > 0}>
              No structure matches this window and filter.
            </span>
          </.empty>
        </tbody>
      </.grid>
    </.panel>
  </div>

  <div :if={@tab == :spawns}>
    <.panel
      title="Still out there"
      count={length(@fresh_spawns)}
      tone={if @fresh_spawns != [], do: :good, else: :neutral}
      hint={"latest per spawn, last #{fresh_window_label()}, ignores the window"}
    >
      <.grid id="scout-fresh-spawns">
        <thead>
          <tr>
            <th class="w-32">Seen</th>
            <th>Spawn</th>
            <th>System</th>
            <th>Location</th>
            <th class="w-16 text-right">Local</th>
            <th class="w-24 text-right">Value</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={row <- @fresh_spawns} id={"scout-fresh-spawn-#{row.id}"}>
            <td><.seen at={row.observed_at} now={@now} tone /></td>
            <td>
              <.subject
                name={row.spawn_name}
                badge={row.spawn_category}
                meta={row.anomaly_type}
                click="show_spawn"
                phx-value-system={row.solar_system_id}
                phx-value-location={row.location_name}
                phx-value-spawn={row.spawn_name}
              />
            </td>
            <td><.sys row={row} systems={@systems} /></td>
            <td class="text-gray-400 text-xs">
              {row.location_name}
              <span :if={row.location_type} class="text-gray-600">· {row.location_type}</span>
            </td>
            <td class="font-mono tabular-nums text-right">{row.players_in_local}</td>
            <td class="font-mono tabular-nums text-right whitespace-nowrap">
              {isk(row.isk_value)}
            </td>
          </tr>
          <.empty :if={@fresh_spawns == []} cols={6}>
            Nothing spawned in the last {fresh_window_label()}.
          </.empty>
        </tbody>
      </.grid>
    </.panel>

    <.panel title="Hotspots" count={length(@hotspots)} hint="grouped by system + location + spawn">
      <.grid id="scout-hotspots">
        <thead>
          <tr>
            <th class="w-20">Sightings</th>
            <th>Spawn</th>
            <th>System</th>
            <th>Location</th>
            <th class="w-24 text-right">Value</th>
            <th class="w-36">First</th>
            <th class="w-36">Last</th>
          </tr>
        </thead>
        <tbody>
          <tr
            :for={row <- @hotspots}
            id={"scout-hotspot-#{row.solar_system_id}-#{:erlang.phash2({row.location_name, row.spawn_name})}"}
          >
            <td class="font-mono tabular-nums text-gray-200">{row.sightings}×</td>
            <td>
              <.subject
                name={row.spawn_name}
                badge={row.spawn_category}
                click="show_spawn"
                phx-value-system={row.solar_system_id}
                phx-value-location={row.location_name}
                phx-value-spawn={row.spawn_name}
              />
            </td>
            <td><.sys row={row} systems={@systems} truesec={false} /></td>
            <td class="text-gray-400 text-xs">
              {row.location_name}
              <span :if={row.location_type} class="text-gray-600">· {row.location_type}</span>
            </td>
            <td class="font-mono tabular-nums text-right whitespace-nowrap">
              {isk(row.isk_value)}
            </td>
            <td class="font-mono text-xs text-gray-500 whitespace-nowrap">
              {at(row.first_seen)}
            </td>
            <td class="font-mono text-xs text-gray-400 whitespace-nowrap">{at(row.last_seen)}</td>
          </tr>
          <.empty :if={@hotspots == []} cols={7}>Nothing to group in this window.</.empty>
        </tbody>
      </.grid>
    </.panel>

    <.panel title="Log" count={count_label(@spawns, @more?)}>
      <.grid id="scout-spawns">
        <thead>
          <tr>
            <th class="w-32">Seen</th>
            <th>Spawn</th>
            <th>System</th>
            <th>Location</th>
            <th class="w-16 text-right">Local</th>
            <th class="w-16 text-right" title="Minutes since downtime">DT+</th>
            <th>Outcome</th>
            <th class="w-24 text-right">Value</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={row <- @spawns} id={"scout-spawn-#{row.id}"}>
            <td><.seen at={row.observed_at} now={@now} /></td>
            <td>
              <.subject
                name={row.spawn_name}
                badge={row.spawn_category}
                meta={row.anomaly_type}
                click="show_spawn"
                phx-value-system={row.solar_system_id}
                phx-value-location={row.location_name}
                phx-value-spawn={row.spawn_name}
              />
            </td>
            <td><.sys row={row} systems={@systems} /></td>
            <td class="text-gray-400 text-xs">
              {row.location_name}
              <span :if={row.location_type} class="text-gray-600">· {row.location_type}</span>
            </td>
            <td class="font-mono tabular-nums text-right">{row.players_in_local}</td>
            <td class="font-mono tabular-nums text-right text-gray-500">
              {if row.minutes_since_downtime, do: "#{row.minutes_since_downtime}m", else: "—"}
            </td>
            <td class="text-gray-400 text-xs">{row.outcome || row.action_taken || "—"}</td>
            <td class="font-mono tabular-nums text-right whitespace-nowrap">
              {isk(row.isk_value)}
            </td>
          </tr>
          <.empty :if={@spawns == []} cols={8}>
            <span :if={@totals && @totals.spawns == 0}>
              No spawn has ever been reported — no scanner client has posted to
              <code class="text-gray-400">/api/maps/:map/scout/spawns</code>
              yet.
            </span>
            <span :if={is_nil(@totals) || @totals.spawns > 0}>
              No spawn matches this window and filter.
            </span>
          </.empty>
        </tbody>
      </.grid>
    </.panel>
  </div>

  <div :if={@more?} class="flex items-center gap-3 mb-6" id="scout-more">
    <button phx-click="load_more" class="btn btn-sm">Load more</button>
    <span class="text-xs text-gray-500">first {@limit} rows</span>
  </div>

  <div
    :if={@detail}
    class="modal modal-open !bg-black/70"
    id="scout-structure-detail"
    phx-window-keydown="close_structure"
    phx-key="Escape"
  >
    <div class="modal-box max-w-5xl max-h-[80vh] overflow-y-auto bg-neutral-900 border border-neutral-800 p-0">
      <div class="flex items-start justify-between gap-4 px-4 py-3 border-b border-neutral-800 sticky top-0 bg-neutral-900 z-10">
        <div class="min-w-0">
          <h3 class="font-semibold truncate">
            {(List.first(@detail.rows) || %{}) |> Map.get(:structure_name) ||
              @detail.structure_id}
          </h3>
          <p class="text-xs text-gray-500">
            {plural(length(@detail.rows), "report", "reports")} · {@detail.structure_id}
            <span :if={nearest_celestial_label(List.first(@detail.rows))}>
              · {nearest_celestial_label(List.first(@detail.rows))}
            </span>
          </p>
        </div>
        <button phx-click="close_structure" class="btn btn-sm btn-ghost">✕</button>
      </div>

      <div class="overflow-x-auto">
        <.grid id="scout-structure-history">
          <thead>
            <tr>
              <th class="w-32">Seen</th>
              <th class="w-20">Event</th>
              <th>System</th>
              <th>Owner</th>
              <th>Status</th>
              <th class="w-28">Comes out</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={row <- @detail.rows} id={"scout-history-#{row.id}"}>
              <td><.seen at={row.observed_at} now={@now} /></td>
              <td>
                <span class={[
                  "badge badge-sm border",
                  row.event == :change && "bg-warning/15 border-warning/40 text-warning",
                  row.event == :seen && "bg-transparent border-neutral-700 text-gray-500"
                ]}>
                  {row.event}
                </span>
              </td>
              <td><.sys row={row} systems={@systems} /></td>
              <td class="text-gray-300">{row.owner_name || "—"}</td>
              <td><.status status={row.status} vulnerable={row.vulnerable} /></td>
              <td><.countdown_cell expires_at={row.timer_expires_at} now={@now} /></td>
            </tr>
            <.empty :if={@detail.rows == []} cols={6}>No history for this structure.</.empty>
          </tbody>
        </.grid>
      </div>
    </div>
    <button class="modal-backdrop" phx-click="close_structure">close</button>
  </div>

  <div
    :if={@spawn_detail}
    class="modal modal-open !bg-black/70"
    id="scout-spawn-detail"
    phx-window-keydown="close_spawn"
    phx-key="Escape"
  >
    <div class="modal-box max-w-5xl max-h-[80vh] overflow-y-auto bg-neutral-900 border border-neutral-800 p-0">
      <div class="flex items-start justify-between gap-4 px-4 py-3 border-b border-neutral-800 sticky top-0 bg-neutral-900 z-10">
        <div class="min-w-0">
          <h3 class="font-semibold truncate">{@spawn_detail.spawn_name}</h3>
          <p class="text-xs text-gray-500 truncate">
            {plural(length(@spawn_detail.rows), "sighting", "sightings")} · {@spawn_detail.location_name} · {system(
              Map.put(@spawn_detail, :solar_system_name, nil),
              @systems
            )}
          </p>
        </div>
        <button phx-click="close_spawn" class="btn btn-sm btn-ghost">✕</button>
      </div>

      <div class="overflow-x-auto">
        <.grid id="scout-spawn-history">
          <thead>
            <tr>
              <th class="w-32">Seen</th>
              <th>System</th>
              <th>Location</th>
              <th class="w-16 text-right">Local</th>
              <th class="w-16 text-right" title="Minutes since downtime">DT+</th>
              <th>Outcome</th>
              <th class="w-24 text-right">Value</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={row <- @spawn_detail.rows} id={"scout-spawn-history-#{row.id}"}>
              <td><.seen at={row.observed_at} now={@now} /></td>
              <td><.sys row={row} systems={@systems} /></td>
              <td class="text-gray-400 text-xs">{row.location_name}</td>
              <td class="font-mono tabular-nums text-right">{row.players_in_local}</td>
              <td class="font-mono tabular-nums text-right text-gray-500">
                {if row.minutes_since_downtime, do: "#{row.minutes_since_downtime}m", else: "—"}
              </td>
              <td class="text-gray-400 text-xs">{row.outcome || row.action_taken || "—"}</td>
              <td class="font-mono tabular-nums text-right whitespace-nowrap">
                {isk(row.isk_value)}
              </td>
            </tr>
            <.empty :if={@spawn_detail.rows == []} cols={7}>No history for this spawn.</.empty>
          </tbody>
        </.grid>
      </div>
    </div>
    <button class="modal-backdrop" phx-click="close_spawn">close</button>
  </div>
</main>
