<%!-- CHEWY PATCH (scout shell): this LiveView is a CHILD of
      `ScoutIntelLive` now (`live_render/3`), so it owns none of the page
      chrome -- no `<main>`, no `<h1>`, no category tab strip. The shell's
      `<.scout_header>` renders all of that once; a second copy here is
      exactly what made category switching look like a different app
      with a different toolbar. --%>
<%= if @access? do %>
  <%!-- This page's own sticky-filter key -- distinct from
        `scout_filters` (ScoutIntelLive) so the two never clobber each
        other's saved state. --%>
  <div
    id="scout-planner-filter-store"
    phx-hook="LocalStorageSetting"
    data-key="scout_planner_filters"
    class="hidden"
  >
  </div>

  <%!-- What used to be this page's own `<header>`: the mode switch (this
        page's second axis, not a second route), the busy/1 indicator,
        the generated-at line and the only button that re-reads
        everything. `scout_toolbar/1` is the shared box every category's
        own controls sit in -- see `ScoutComponents`. --%>
  <.scout_toolbar id="scout-planner-toolbar">
    <.busy
      busy={@rank_loading? or @sweep_loading? or @split_loading? or @heat_loading?}
      label="computing"
    />

    <span
      :if={@mode == :rank and not is_nil(@generated_at) and not @rank_loading?}
      class="text-[11px] text-gray-500 whitespace-nowrap"
      title="When this ranking was computed — it is not re-queried on a timer"
    >
      generated <span class="text-gray-300">{ago(@generated_at, @now)}</span> · times UTC
    </span>

    <div class="ml-auto flex items-center gap-2">
      <%!-- CHEWY PATCH (scout sweep): a second MODE on this same page, not
            a second route -- `rank` is the origin-ball ranking, `sweep` is
            the whole-region route, start points, region heat and a k-way
            split. --%>
      <div role="tablist" class="tabs tabs-boxed tabs-sm bg-neutral-950/60">
        <button
          type="button"
          phx-click="switch_mode"
          phx-value-mode="rank"
          role="tab"
          id="scout-planner-mode-rank"
          class={["tab", @mode == :rank && "tab-active"]}
          title="Rank the systems nearest an origin by how badly they need scouting"
        >
          Rank
        </button>
        <button
          type="button"
          phx-click="switch_mode"
          phx-value-mode="sweep"
          role="tab"
          id="scout-planner-mode-sweep"
          class={["tab", @mode == :sweep && "tab-active"]}
          title="Route a whole region, suggest a start, split it across pilots"
        >
          Sweep
        </button>
        <button
          type="button"
          phx-click="switch_mode"
          phx-value-mode="targets"
          role="tab"
          id="scout-planner-mode-targets"
          class={["tab", @mode == :targets && "tab-active"]}
          title="Route the systems where a structure finding was last seen — unanchoring hulls by default"
        >
          Targets
        </button>
      </div>

      <button phx-click="refresh" id="scout-planner-refresh" class="btn btn-sm btn-ghost">
        Refresh
      </button>
    </div>
  </.scout_toolbar>

  <%!-- ================================ RANK ============================ --%>
  <div :if={@mode == :rank}>
    <div class="mb-4 p-2 rounded-lg border border-neutral-800 bg-neutral-900/30">
      <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-2 items-start">
        <div class="min-w-0 col-span-2 sm:col-span-1 xl:col-span-2">
          <label class="block text-[10px] uppercase tracking-wider text-gray-500 mb-0.5">
            Origin system
          </label>
          <div class="relative" phx-click-away="close_origin_search">
            <form phx-change="search_origin" phx-submit="search_origin">
              <input
                type="text"
                name="q"
                id="scout-planner-origin-q"
                value={@origin_q}
                phx-debounce="300"
                autocomplete="off"
                placeholder="Search by name…"
                class="input input-sm input-bordered bg-neutral-950/60 w-full"
              />
            </form>
            <div
              :if={@origin_matches != []}
              class="absolute z-20 mt-1 w-full min-w-[14rem] rounded-lg border border-neutral-700 bg-neutral-900 shadow-lg max-h-64 overflow-auto"
            >
              <button
                :for={m <- @origin_matches}
                type="button"
                phx-click="select_origin"
                phx-value-id={m.solar_system_id}
                phx-value-name={m.solar_system_name}
                class="flex w-full items-baseline justify-between gap-2 px-3 py-1.5 text-left text-sm hover:bg-neutral-800"
              >
                <span class="truncate">{m.solar_system_name}</span>
                <span class="text-[11px] text-gray-500 truncate">{m.region_name}</span>
              </button>
            </div>
          </div>
          <div class="mt-1 min-h-[1.25rem]">
            <button
              :if={@origin_id}
              phx-click="clear_origin"
              id="scout-planner-origin-clear"
              title="Clear the origin"
              class="badge badge-sm gap-1 border-0 bg-primary/20 text-primary hover:bg-primary/30"
            >
              {@origin_name || @origin_id} ✕
            </button>
            <span :if={is_nil(@origin_id)} class="text-[10px] text-gray-500">
              nothing ranks until an origin is picked
            </span>
          </div>
        </div>

        <.field label="Kind">
          <form phx-change="select_kind">
            <select
              name="kind"
              id="scout-planner-kind"
              class="select select-sm select-bordered bg-neutral-950/60 w-full py-0"
              title="Coverage ladder kind — visit/anoms/sigs/grid, design doc section 2"
            >
              <option
                :for={k <- ~w(visit anoms sigs grid)}
                value={k}
                selected={k == to_string(@kind)}
              >
                {String.capitalize(k)}
              </option>
            </select>
          </form>
        </.field>

        <.field label="Stops">
          <form phx-change="select_limit">
            <select
              name="limit"
              id="scout-planner-limit"
              class="select select-sm select-bordered bg-neutral-950/60 w-full py-0"
            >
              <option :for={n <- [10, 25, 50, 100]} value={n} selected={n == @limit}>
                {n} stops
              </option>
            </select>
          </form>
        </.field>

        <.field label="Max jumps" hint="hard cap 40">
          <form phx-change="update_max_jumps">
            <input
              type="number"
              name="max_jumps"
              id="scout-planner-max-jumps"
              min="1"
              max="40"
              value={@max_jumps}
              phx-debounce="400"
              class="input input-sm input-bordered bg-neutral-950/60 w-full"
            />
          </form>
        </.field>

        <div class="col-span-2 sm:col-span-1">
          <.region_picker
            id="scout-planner-regions"
            label="Regions"
            scope="rank"
            query={@region_q}
            matches={@region_matches}
            selected={@regions}
            title="Narrows the ranking to these regions — empty means no narrowing"
          />
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 mt-2 pt-2 border-t border-neutral-800/70">
        <div class="max-w-full overflow-x-auto">
          <div class="join" id="scout-planner-security">
            <.space_chip
              :for={{key, label} <- @security_types}
              key={key}
              label={label}
              id={"scout-planner-space-#{key}"}
              title={"Rank #{label} systems — unticked space is not ranked at all"}
              selected={key in @security}
            />
          </div>
        </div>

        <button
          :if={length(@security) < length(@security_types)}
          phx-click="reset_space"
          id="scout-planner-security-reset"
          class="btn btn-sm btn-ghost text-gray-400"
        >
          All space ✕
        </button>
      </div>
    </div>

    <.scout_pane loading={@rank_loading?}>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5">
        <.stat label="Candidates in scope" value={to_string(@candidates)} />
        <.stat
          label="Stops shown"
          value={to_string(length(@stops))}
          hint={"of #{@limit} requested"}
        />
        <.stat
          label="Unseen"
          value={to_string(count_reason(@stops, :unseen))}
          tone={if count_reason(@stops, :unseen) > 0, do: :urgent, else: :neutral}
        />
        <.stat label="Frontier" value={to_string(count_reason(@stops, :frontier))} />
      </div>

      <div :if={@route_ids != ""} class="flex flex-wrap items-center gap-2 mb-3">
        <input
          type="text"
          readonly
          id="scout-planner-route"
          value={@route_ids}
          onclick="this.select()"
          title="Gate-leg stops in GET /scout/plan's own nearest-neighbour order -- byte-for-byte the list the bot flies"
          class="input input-sm input-bordered bg-neutral-950/60 w-full sm:w-96 max-w-full font-mono text-xs"
        />
        <button
          type="button"
          phx-hook="CopyToClipboard"
          id="scout-planner-copy-route"
          data-url={@route_ids}
          class="btn btn-sm btn-ghost"
        >
          Copy route
        </button>

        <%!-- Setting the route is ESI-only: the game client can take a single
              destination, not an ordered list, so this goes out with ONE
              character's token and the page has to name whose. --%>
        <form phx-change="select_character" class="flex items-center gap-2">
          <select
            name="character_eve_id"
            id="scout-planner-character"
            title="Whose autopilot this route is written to, through ESI"
            class="select select-sm select-bordered bg-neutral-950/60 py-0 max-w-[12rem]"
          >
            <option
              :for={character <- @characters}
              value={character.eve_id}
              selected={character.eve_id == @character_eve_id}
            >
              {character.name}
            </option>
          </select>
        </form>
        <button
          type="button"
          phx-click="set_route"
          id="scout-planner-set-route"
          disabled={@characters == []}
          title="Replaces this character's in-game route with the stops above, in order"
          class="btn btn-sm btn-primary"
        >
          Set route
        </button>
        <span :if={@characters == []} class="text-[11px] text-gray-500">
          No tracked character on this account to set a route on.
        </span>
        <.route_outcome status={@route_status} scope={:rank} />
      </div>

      <.panel
        id="scout-planner-table-panel"
        title="Ranked systems"
        count={length(@stops)}
        hint={
          if @origin_id, do: "sorted by score, " <> to_string(@kind) <> " coverage", else: nil
        }
      >
        <.grid id="scout-planner-table">
          <thead>
            <tr>
              <th>System</th>
              <th>Region</th>
              <th>Class / Sec</th>
              <th>Coverage</th>
              <th>Verdict</th>
              <th>Score</th>
              <th>Reason</th>
              <th class="text-right">Jumps</th>
              <th>Leg</th>
              <th>Why</th>
              <th class="w-24"></th>
            </tr>
          </thead>
          <tbody>
            <tr :for={stop <- @stops} id={"scout-planner-#{stop.solar_system_id}"}>
              <td>
                <div class="flex items-center gap-1.5 whitespace-nowrap">
                  <button
                    phx-click="select_origin"
                    phx-value-id={stop.solar_system_id}
                    phx-value-name={stop.name}
                    class="link link-hover decoration-dotted underline-offset-2"
                    title="Use as the new origin"
                  >
                    {stop.name}
                  </button>
                  <.space_badge space={stop.space} />
                </div>
              </td>
              <td class="text-xs text-gray-400">{stop.region_name || "—"}</td>
              <td><.stop_class stop={stop} /></td>
              <td><.coverage_ladder coverage={stop.coverage} kind={@kind} now={@now} /></td>
              <td><.grid_verdict stop={stop} /></td>
              <td class="font-mono tabular-nums">{score_fmt(stop.score)}</td>
              <td><.reason_badge reason={stop.reason} /></td>
              <td class="text-right tabular-nums">{stop.jumps}</td>
              <td class="text-xs text-gray-400">{stop.leg}</td>
              <td><.terms_hint terms={stop.terms} /></td>
              <td><.stale_cell stop={stop} /></td>
            </tr>
            <.empty :if={@stops == [] and @rank_loading?} cols={11}>
              Ranking…
            </.empty>
            <.empty :if={@stops == [] and not @rank_loading? and is_nil(@origin_id)} cols={11}>
              Search for an origin system to begin.
            </.empty>
            <%!-- `@origin_id` is an integer or nil, never a boolean, and `and`
                  raises BadBooleanError on anything else -- which crashed the
                  whole page on first render. --%>
            <.empty
              :if={
                @stops == [] and not @rank_loading? and not is_nil(@origin_id) and
                  not is_nil(@plan_error)
              }
              cols={11}
            >
              {plan_error_message(@plan_error)}
            </.empty>
            <.empty
              :if={
                @stops == [] and not @rank_loading? and not is_nil(@origin_id) and
                  is_nil(@plan_error)
              }
              cols={11}
            >
              Nothing in scope needs scouting right now.
            </.empty>
          </tbody>
        </.grid>
      </.panel>
    </.scout_pane>
  </div>

  <%!-- ================================ SWEEP =========================== --%>
  <%!-- CHEWY PATCH (scout sweep): design doc "whole-region sweeps" --
        scope is a MEMBERSHIP over up to 3 regions, not a ball, so there
        is no origin/limit/max_jumps here; `compress` is an explicit,
        labelled option rather than a silent optimisation (section 6:
        ESI exposes no way to verify a pilot's autopilot preference). --%>
  <div :if={@mode == :sweep}>
    <div class="mb-4 p-2 rounded-lg border border-neutral-800 bg-neutral-900/30">
      <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-2 items-start">
        <div class="col-span-2">
          <.region_picker
            id="scout-sweep-regions"
            label="Scope (regions)"
            scope="sweep"
            query={@sweep_region_q}
            matches={@sweep_region_matches}
            selected={@sweep_regions}
            max={3}
            title="The regions this sweep covers -- at most 3 (~450 systems), the matrix cap"
          />
        </div>

        <.field label="Kind">
          <form phx-change="select_sweep_kind">
            <select
              name="kind"
              id="scout-sweep-kind"
              class="select select-sm select-bordered bg-neutral-950/60 w-full py-0"
              title="Coverage ladder kind — visit/anoms/sigs/grid"
            >
              <option
                :for={k <- ~w(visit anoms sigs grid)}
                value={k}
                selected={k == to_string(@sweep_kind)}
              >
                {String.capitalize(k)}
              </option>
            </select>
          </form>
        </.field>

        <.field label="Split (k)">
          <form phx-change="update_sweep_k">
            <input
              type="number"
              name="k"
              id="scout-sweep-k"
              min="1"
              max="6"
              value={@sweep_k}
              phx-debounce="400"
              title="Divide this sweep's systems across k pilots, 1-6"
              class="input input-sm input-bordered bg-neutral-950/60 w-full"
            />
          </form>
          <%!-- Feedback AT the control. The split panel is a screenful below a
                189-row sweep table, so without this a changed `k` looks like it
                did nothing at all. --%>
          <p :if={@sweep_parts != []} class="mt-0.5 text-[10px] text-gray-400 truncate">
            {length(@sweep_parts)} parts, longest
            <span class="text-gray-200 tabular-nums">
              {@sweep_parts |> Enum.map(& &1.jumps) |> Enum.max()}
            </span>
            jumps
          </p>
          <p :if={@split_loading?} class="mt-0.5 text-[10px] text-orange-300 truncate">
            splitting…
          </p>
          <p
            :if={
              @sweep_k > 1 and @sweep_parts == [] and not @split_loading? and
                not is_nil(@sweep_result)
            }
            class="mt-0.5 text-[10px] text-gray-500 truncate"
          >
            nothing to split
          </p>
        </.field>

        <label
          class="flex min-w-0 items-start gap-1.5 text-[11px] text-gray-300 cursor-pointer col-span-2 sm:col-span-1"
          title="Assumes the client routes shortest-path with no avoidance list -- ESI exposes no way to read a pilot's autopilot preference, so a wrong assumption here produces a route with holes in it, not a slower one"
        >
          <input
            type="checkbox"
            checked={@sweep_compress}
            phx-click="toggle_sweep_compress"
            class="checkbox checkbox-xs mt-0.5"
          />
          <span>
            Compress waypoints
            <span class="block text-gray-500">
              assumes shortest-path routing, no avoidance list
            </span>
          </span>
        </label>

        <%!-- CHEWY PATCH (stable sweeps): the reason the same region gave
              three different start systems on three different days. A
              sweep's MEMBERSHIP is normally time-dependent -- anything
              still fresh for `kind` is dropped, and anything another
              pilot claimed through "Assign all" is excluded for 12h --
              so the stop set, and therefore the split and its start
              systems, drift with the data. Stable mode takes the scope
              EXACTLY as the region and the bands define it, and runs the
              balance to exhaustion instead of stopping at a wall clock,
              so the same scope gives the same parts every time. --%>
        <label
          class="flex min-w-0 items-start gap-1.5 text-[11px] text-gray-300 cursor-pointer col-span-2 sm:col-span-1"
          title="Membership = every system in the scope and the ticked bands, regardless of when it was last scouted or who claimed it; balancing runs to exhaustion rather than stopping at a 2s wall clock. Same scope in, same parts out -- at the cost of a longer split on a big region at k=2."
        >
          <input
            type="checkbox"
            id="scout-sweep-stable"
            checked={@sweep_stable}
            phx-click="toggle_sweep_stable"
            class="checkbox checkbox-xs mt-0.5"
          />
          <span>
            Stable plan
            <span class="block text-gray-500">
              same scope ⇒ same parts; ignores freshness and claims
            </span>
          </span>
        </label>
      </div>

      <div class="flex flex-wrap items-center gap-2 mt-2 pt-2 border-t border-neutral-800/70">
        <div class="max-w-full overflow-x-auto">
          <div class="join" id="scout-sweep-security">
            <.space_chip
              :for={{key, label} <- @security_types}
              key={key}
              label={label}
              event="toggle_sweep_space"
              id={"scout-sweep-space-#{key}"}
              title={"Visit #{label} systems on this sweep — unticked space is never a stop, but the route may still pass through it"}
              selected={key in @sweep_security}
            />
          </div>
        </div>
        <button
          :if={length(@sweep_security) < length(@security_types)}
          phx-click="reset_sweep_space"
          id="scout-sweep-security-reset"
          class="btn btn-sm btn-ghost text-gray-400"
        >
          All space ✕
        </button>
        <%!-- CHEWY PATCH: the band filter picks STOPS, not the graph the
              route runs over -- "sweep Metropolis lowsec" still drives
              through its highsec, which is the whole point of routing
              over the full k-space graph. Said here because the stop
              table alone cannot show it: the transit systems are not
              rows. --%>
        <span class="text-[11px] text-gray-500" id="scout-sweep-security-note">
          visiting {security_summary(@sweep_security)}; the route still transits whatever it must
        </span>
      </div>

      <%!-- CHEWY PATCH (pinned split starts): "I would like to keep my
            chars in same place" -- a split normally picks each part's
            start geometrically, which sends every pilot somewhere else
            before the first scan. Pin a part to the system its character
            is already sitting in and the partition is built AROUND that
            system and routed from it; the system itself needs not be a
            stop (a parked pilot usually is nowhere interesting), in
            which case the approach leg still counts in that part's
            jumps. Lives next to the `k` control, not in the split panel
            below the route table, for the same reason the `k` feedback
            does. --%>
      <div
        :if={@sweep_k > 1}
        class="flex flex-wrap items-start gap-2 mt-2 pt-2 border-t border-neutral-800/70"
        phx-click-away="close_part_start_search"
      >
        <span class="text-[10px] uppercase tracking-wider text-gray-500 mt-4">
          Pilot starts
        </span>
        <div
          :for={slot <- 0..(@sweep_k - 1)}
          id={"scout-sweep-start-slot-#{slot}"}
          class="relative w-36"
        >
          <div class="text-[10px] text-gray-500 mb-0.5">Part {slot + 1}</div>
          <button
            :if={Map.has_key?(@sweep_starts, slot)}
            type="button"
            phx-click="clear_part_start"
            phx-value-slot={slot}
            id={"scout-sweep-start-slot-#{slot}-clear"}
            title="Unpin this part -- it goes back to a seeded start"
            class="badge badge-sm gap-1 border-0 bg-primary/20 text-primary hover:bg-primary/30 max-w-full truncate"
          >
            {@sweep_starts[slot].name} ✕
          </button>
          <form
            :if={not Map.has_key?(@sweep_starts, slot)}
            phx-change="search_part_start"
            phx-submit="search_part_start"
          >
            <input type="hidden" name="slot" value={slot} />
            <input
              type="text"
              name="q"
              id={"scout-sweep-start-slot-#{slot}-q"}
              value={if @sweep_start_slot == slot, do: @sweep_start_q, else: ""}
              phx-debounce="300"
              autocomplete="off"
              placeholder="Where it is…"
              title="The system this pilot is parked in -- the part is built around it and routed from it"
              class="input input-xs input-bordered bg-neutral-950/60 w-full"
            />
          </form>
          <div
            :if={@sweep_start_slot == slot and @sweep_start_matches != []}
            class="absolute z-20 mt-1 w-full min-w-[14rem] rounded-lg border border-neutral-700 bg-neutral-900 shadow-lg max-h-64 overflow-auto"
          >
            <button
              :for={m <- @sweep_start_matches}
              type="button"
              phx-click="select_part_start"
              phx-value-slot={slot}
              phx-value-id={m.solar_system_id}
              phx-value-name={m.solar_system_name}
              class="flex w-full items-baseline justify-between gap-2 px-3 py-1.5 text-left text-sm hover:bg-neutral-800"
            >
              <span class="truncate">{m.solar_system_name}</span>
              <span class="text-[11px] text-gray-500 truncate">{m.region_name}</span>
            </button>
          </div>
        </div>
        <button
          :if={@sweep_starts != %{}}
          type="button"
          phx-click="clear_part_starts"
          id="scout-sweep-starts-clear"
          class="btn btn-xs btn-ghost text-gray-400 mt-4"
        >
          Unpin all ✕
        </button>
        <span class="text-[11px] text-gray-500 mt-4 max-w-sm">
          a pinned part starts where its character already is; unpinned parts are seeded as before
        </span>
      </div>
    </div>

    <%!-- `empty/1` is a `<tr>`; dropped straight into a `<div>` the browser
          discards it, so these two messages were invisible. `note/1` is the
          non-table empty state. --%>
    <.note :if={@sweep_regions == [] and is_nil(@sweep_error)} id="scout-sweep-no-scope">
      Pick a scope above, or a region from the heat table below, to sweep it.
    </.note>

    <.note :if={@sweep_error} id="scout-sweep-error">
      {plan_error_message(@sweep_error)}
    </.note>

    <.note :if={@sweep_loading? and is_nil(@sweep_result)} id="scout-sweep-loading">
      Routing this scope…
    </.note>

    <.scout_pane :if={@sweep_result} loading={@sweep_loading?}>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5">
        <.stat label="Systems" value={to_string(@sweep_result.systems)} />
        <.stat label="Total jumps" value={to_string(@sweep_result.jumps)} />
        <.stat
          label="Waypoints"
          value={to_string(length(@sweep_result.waypoints))}
          hint={if @sweep_result.compressed?, do: "after compression", else: "uncompressed"}
        />
        <.stat
          label="Estimated time"
          value={sweep_hours(@sweep_result.systems)}
          hint="guess: 5 min/system, jump time not counted"
        />
      </div>

      <.panel
        id="scout-sweep-starts-panel"
        title="Start points"
        hint="top 3 by route cost, or search for the system you are in"
      >
        <div class="flex flex-wrap items-center gap-2 p-2">
          <button
            :for={s <- @sweep_result.starts}
            type="button"
            phx-click="select_sweep_start"
            phx-value-id={s.solar_system_id}
            phx-value-name={s.name}
            id={"scout-sweep-start-#{s.solar_system_id}"}
            class={[
              "btn btn-sm gap-1",
              if(s.solar_system_id == @sweep_result.start, do: "btn-primary", else: "btn-outline")
            ]}
          >
            {s.name}
            <span class="font-mono text-[11px] opacity-80">{s.jumps}j</span>
          </button>

          <%!-- CHEWY PATCH (searchable start picker): the three buttons
                above are the three CHEAPEST starts, which is never "the
                system my character is parked in". This is the same
                type-to-search dropdown the rank mode's origin uses, on
                slot "main", and the system it picks does not have to be
                a stop: `Sweep.sweep/1` routes FROM an out-of-scope start
                and counts the approach leg without listing it. --%>
          <div class="relative w-48" phx-click-away="close_part_start_search">
            <form phx-change="search_part_start" phx-submit="search_part_start">
              <input type="hidden" name="slot" value="main" />
              <input
                type="text"
                name="q"
                id="scout-sweep-start-q"
                value={if @sweep_start_slot == :main, do: @sweep_start_q, else: ""}
                phx-debounce="300"
                autocomplete="off"
                placeholder="Start somewhere else…"
                title="Start this sweep from any system by name -- typically the one your character is already in"
                class="input input-sm input-bordered bg-neutral-950/60 w-full"
              />
            </form>
            <div
              :if={@sweep_start_slot == :main and @sweep_start_matches != []}
              id="scout-sweep-start-matches"
              class="absolute z-20 mt-1 w-full min-w-[14rem] rounded-lg border border-neutral-700 bg-neutral-900 shadow-lg max-h-64 overflow-auto"
            >
              <button
                :for={m <- @sweep_start_matches}
                type="button"
                phx-click="select_part_start"
                phx-value-slot="main"
                phx-value-id={m.solar_system_id}
                phx-value-name={m.solar_system_name}
                class="flex w-full items-baseline justify-between gap-2 px-3 py-1.5 text-left text-sm hover:bg-neutral-800"
              >
                <span class="truncate">{m.solar_system_name}</span>
                <span class="text-[11px] text-gray-500 truncate">{m.region_name}</span>
              </button>
            </div>
          </div>

          <span
            :if={
              @sweep_start &&
                not Enum.any?(@sweep_result.starts, &(&1.solar_system_id == @sweep_start))
            }
            id="scout-sweep-start-custom"
            class="badge badge-sm border-0 bg-primary/20 text-primary"
            title="Starting from this system; it is only a stop if the sweep needed it anyway"
          >
            from {@sweep_start_name || @sweep_start}
          </span>

          <button
            :if={@sweep_start}
            type="button"
            phx-click="clear_sweep_start"
            id="scout-sweep-start-clear"
            class="btn btn-sm btn-ghost text-gray-400"
          >
            Auto-pick best ✕
          </button>
        </div>
      </.panel>

      <div class="flex flex-wrap items-center gap-2 mb-3">
        <form phx-change="select_character" class="flex items-center gap-2">
          <select
            name="character_eve_id"
            id="scout-sweep-character"
            title="Whose autopilot the full route is written to, through ESI"
            class="select select-sm select-bordered bg-neutral-950/60 py-0 max-w-[12rem]"
          >
            <option
              :for={character <- @characters}
              value={character.eve_id}
              selected={character.eve_id == @character_eve_id}
            >
              {character.name}
            </option>
          </select>
        </form>
        <button
          type="button"
          phx-click="set_sweep_route"
          id="scout-sweep-set-route"
          disabled={@characters == []}
          title="Replaces this character's in-game route with the full sweep, in order"
          class="btn btn-sm btn-primary"
        >
          Set full route
        </button>
        <.route_outcome status={@route_status} scope={:sweep} />
      </div>

      <%!-- The split sits ABOVE the route table: on a 189-system sweep the
            table is several screens, and a panel below it is a panel nobody
            scrolls to. --%>
      <.panel
        :if={@sweep_k > 1 and @sweep_parts != []}
        id="scout-sweep-split-panel"
        title={"Split across #{@sweep_k} pilots"}
        hint="makespan, not total jumps -- parts fly in parallel"
      >
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3 p-3">
          <div
            :for={part <- @sweep_parts}
            id={"scout-sweep-part-#{part.index}"}
            class="rounded-lg border border-neutral-800 bg-neutral-950/40 p-3"
          >
            <div class="text-xs uppercase tracking-wider text-gray-500 mb-1">
              Part {part.index + 1}
            </div>
            <div class="text-sm text-gray-200 mb-2">
              {length(part.system_ids)} systems · {part.jumps} jumps · starts {start_name(
                part.start,
                @sweep_result.stops,
                @sweep_starts
              )}
              <span
                :if={part.pinned?}
                class="badge badge-xs border-0 bg-primary/20 text-primary align-middle"
                title="Pinned: this part was built around the system you parked this character in, and the jumps include flying out of it"
              >
                pinned
              </span>
            </div>
            <form phx-change="select_part_character" class="flex items-center gap-2 mb-2">
              <input type="hidden" name="part" value={part.index} />
              <select
                name="character_eve_id"
                id={"scout-sweep-part-#{part.index}-character"}
                class="select select-sm select-bordered bg-neutral-950/60 py-0 w-full"
              >
                <option
                  :for={character <- @characters}
                  value={character.eve_id}
                  selected={character.eve_id == Map.get(@sweep_pilots, part.index)}
                >
                  {character.name}
                </option>
              </select>
            </form>
            <button
              type="button"
              phx-click="set_part_route"
              phx-value-part={part.index}
              id={"scout-sweep-part-#{part.index}-set-route"}
              disabled={@characters == []}
              class="btn btn-sm btn-primary"
            >
              Set route
            </button>
            <.route_outcome status={@route_status} scope={{:part, part.index}} />
          </div>
        </div>
        <div class="p-3 pt-0">
          <button
            type="button"
            phx-click="assign_all_parts"
            id="scout-sweep-assign-all"
            class="btn btn-sm btn-outline"
          >
            Assign all
          </button>
        </div>
      </.panel>

      <.panel
        id="scout-sweep-table-panel"
        title="Sweep route"
        count={length(@sweep_result.stops)}
        hint={to_string(@sweep_kind) <> " coverage"}
      >
        <.grid id="scout-sweep-table">
          <thead>
            <tr>
              <th class="text-right">#</th>
              <th>System</th>
              <th>Region</th>
              <th>Class / Sec</th>
              <th>Coverage</th>
              <th>Reason</th>
              <th class="text-right">Jumps</th>
              <th>WP</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={stop <- @sweep_result.stops} id={"scout-sweep-#{stop.solar_system_id}"}>
              <td class="text-right text-xs text-gray-500">{stop.order}</td>
              <td>
                <div class="flex items-center gap-1.5 whitespace-nowrap">
                  {stop.name}
                  <.space_badge space={stop.space} />
                </div>
              </td>
              <td class="text-xs text-gray-400">{stop.region_name || "—"}</td>
              <td><.sweep_class_cell stop={stop} /></td>
              <td><.coverage_ladder coverage={stop.coverage} kind={@sweep_kind} now={@now} /></td>
              <td><.reason_badge reason={stop.reason} /></td>
              <td class="text-right tabular-nums">{stop.jumps_from_prev}</td>
              <td><.waypoint_badge waypoint?={stop.waypoint?} /></td>
            </tr>
            <.empty :if={@sweep_result.stops == []} cols={8}>
              Nothing in this scope needs scouting right now.
            </.empty>
          </tbody>
        </.grid>
      </.panel>
    </.scout_pane>

    <.panel
      id="scout-region-heat-panel"
      title="Region heat"
      hint={
        "#{@sweep_kind} coverage of #{security_summary(@sweep_security)} by region, worst first -- click a row to sweep it"
      }
      class={@heat_loading? && "opacity-50"}
    >
      <.grid id="scout-region-heat-table">
        <thead>
          <tr>
            <th>Region</th>
            <th class="text-right">Systems</th>
            <th>Coverage</th>
            <th class="text-right">Stale</th>
            <th class="text-right">Unseen</th>
            <th class="text-right">Median age</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={row <- @region_heat || []} id={"scout-heat-#{row.region_id}"}>
            <td>
              <button
                type="button"
                phx-click="select_region_heat"
                phx-value-id={row.region_id}
                class="link link-hover decoration-dotted underline-offset-2"
                title="Sweep this region"
              >
                {row.region_name}
              </button>
            </td>
            <td class="text-right tabular-nums">{row.systems}</td>
            <td>
              <.heat_bar
                covered={row.covered}
                stale={row.stale}
                unseen={row.unseen}
                systems={row.systems}
              />
            </td>
            <td class="text-right tabular-nums">{row.stale}</td>
            <td class="text-right tabular-nums">{row.unseen}</td>
            <td class="text-right tabular-nums font-mono text-xs">{age_fmt(row.median_age_s)}</td>
          </tr>
          <.empty :if={(@region_heat || []) == [] and @heat_loading?} cols={6}>
            Measuring every region…
          </.empty>
          <.empty :if={(@region_heat || []) == [] and not @heat_loading?} cols={6}>
            No region holds {security_summary(@sweep_security)}, or no coverage has ever been
            recorded there.
          </.empty>
        </tbody>
      </.grid>
    </.panel>
  </div>

  <%!-- =============================== TARGETS ========================== --%>
  <%!-- CHEWY PATCH (target routing): the candidate set is a FINDING set,
        not a region and not a ball -- `WandererApp.Scout.Targets` turns
        `scout_structures_v1` rows into a system list and hands it to the
        same `Sweep.sweep/1` the mode above uses, so everything below the
        filter row is the sweep vocabulary. No kind selector (freshness
        never gates a finding) and no k-split (a target run is one
        pilot's errand); what it has instead is a strike-off list and a
        radius, because 39 unanchoring systems over 14 regions is not one
        route. --%>
  <div :if={@mode == :targets}>
    <div class="mb-4 p-2 rounded-lg border border-neutral-800 bg-neutral-900/30">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[10px] uppercase tracking-wider text-gray-500">Findings</span>
        <div class="join" id="scout-targets-families">
          <button
            :for={family <- Targets.families()}
            type="button"
            phx-click="toggle_targets_family"
            phx-value-family={family}
            id={"scout-targets-family-#{family}"}
            class={[
              "btn btn-xs join-item",
              if(family in @targets_families, do: "btn-primary", else: "btn-ghost text-gray-400")
            ]}
          >
            {Targets.family_label(family)}
          </button>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-2 items-start mt-2 pt-2 border-t border-neutral-800/70">
        <.field label="Confirmed within">
          <form phx-change="select_targets_window">
            <select
              name="window"
              id="scout-targets-window"
              class="select select-sm select-bordered bg-neutral-950/60 w-full py-0"
              title="Ignore a finding nobody has re-confirmed in this long — a six-day-old sighting is a guess, not a target"
            >
              <option
                :for={days <- Targets.window_days_options()}
                value={days}
                selected={days == @targets_window_days}
              >
                {days}d
              </option>
              <option value="any" selected={is_nil(@targets_window_days)}>Any age</option>
            </select>
          </form>
        </.field>

        <.field label="Max jumps">
          <form phx-change="update_targets_radius">
            <input
              type="number"
              name="radius"
              id="scout-targets-radius"
              min="0"
              max={Targets.max_radius()}
              value={@targets_radius}
              phx-debounce="400"
              title="How far from the start a target may be. 0 turns it off; it does nothing until a start is picked, since there is nothing to measure from."
              class="input input-sm input-bordered bg-neutral-950/60 w-full"
            />
          </form>
          <p
            :if={@targets_radius > 0 and is_nil(@targets_start)}
            class="mt-0.5 text-[10px] text-gray-500 truncate"
          >
            pick a start to apply it
          </p>
        </.field>

        <%!-- The same type-to-search dropdown the other two modes use, on
              its own slot: a target run starts where the character is
              parked, which is almost never one of the targets. --%>
        <.field label="Start" class="col-span-2 sm:col-span-1">
          <div class="relative" phx-click-away="close_part_start_search">
            <button
              :if={@targets_start}
              type="button"
              phx-click="clear_targets_start"
              id="scout-targets-start-clear"
              title="Unpin this start — the route opens wherever it is cheapest"
              class="badge badge-sm gap-1 border-0 bg-primary/20 text-primary hover:bg-primary/30 max-w-full truncate"
            >
              {@targets_start_name || @targets_start} ✕
            </button>
            <form
              :if={is_nil(@targets_start)}
              phx-change="search_part_start"
              phx-submit="search_part_start"
            >
              <input type="hidden" name="slot" value="target" />
              <input
                type="text"
                name="q"
                id="scout-targets-start-q"
                value={if @sweep_start_slot == :target, do: @sweep_start_q, else: ""}
                phx-debounce="300"
                autocomplete="off"
                placeholder="Where you are…"
                class="input input-sm input-bordered bg-neutral-950/60 w-full"
              />
            </form>
            <div
              :if={@sweep_start_slot == :target and @sweep_start_matches != []}
              id="scout-targets-start-matches"
              class="absolute z-20 mt-1 w-full min-w-[14rem] rounded-lg border border-neutral-700 bg-neutral-900 shadow-lg max-h-64 overflow-auto"
            >
              <button
                :for={m <- @sweep_start_matches}
                type="button"
                phx-click="select_part_start"
                phx-value-slot="target"
                phx-value-id={m.solar_system_id}
                phx-value-name={m.solar_system_name}
                class="flex w-full items-baseline justify-between gap-2 px-3 py-1.5 text-left text-sm hover:bg-neutral-800"
              >
                <span class="truncate">{m.solar_system_name}</span>
                <span class="text-[11px] text-gray-500 truncate">{m.region_name}</span>
              </button>
            </div>
          </div>
        </.field>

        <%!-- A decommission is a FIXED 7 days from a start nobody saw, so
              `unanchoring_since + 7d` is the latest the hull can still be
              there (`WandererApp.Scout.Unanchor`). Past it, the trip is
              wasted -- but it is a prediction, so it is a tick box, not a
              hard rule. --%>
        <label
          class="flex min-w-0 items-start gap-1.5 text-[11px] text-gray-300 cursor-pointer col-span-2"
          title="Drop an unanchoring hull once its predicted maximum (first sighting + 7 days) has passed — it cannot still be coming out. Only ever drops rows that carry a prediction."
        >
          <input
            type="checkbox"
            id="scout-targets-hide-expired"
            checked={@targets_hide_expired}
            phx-click="toggle_targets_expired"
            class="checkbox checkbox-xs mt-0.5"
          />
          <span>
            Hide findings past their window
            <span class="block text-gray-500">unanchoring: first sighting + 7d</span>
          </span>
        </label>
      </div>

      <div class="flex flex-wrap items-center gap-2 mt-2 pt-2 border-t border-neutral-800/70">
        <div class="max-w-full overflow-x-auto">
          <div class="join" id="scout-targets-security">
            <.space_chip
              :for={{key, label} <- @security_types}
              key={key}
              label={label}
              event="toggle_targets_space"
              id={"scout-targets-space-#{key}"}
              title={"Keep #{label} targets — the route still transits whatever it must"}
              selected={key in @targets_security}
            />
          </div>
        </div>
        <button
          :if={length(@targets_security) < length(@security_types)}
          phx-click="reset_targets_space"
          id="scout-targets-security-reset"
          class="btn btn-sm btn-ghost text-gray-400"
        >
          All space ✕
        </button>
      </div>

      <%!-- The strike-off list. Kept visible whenever it is non-empty, in
            the toolbar rather than next to the table, because a filter
            you cannot see is a route you cannot explain. --%>
      <div
        :if={@targets_ignore != %{}}
        class="flex flex-wrap items-center gap-2 mt-2 pt-2 border-t border-neutral-800/70"
        id="scout-targets-ignored"
      >
        <span class="text-[10px] uppercase tracking-wider text-gray-500">Ignored</span>
        <button
          :for={{id, name} <- Enum.sort_by(@targets_ignore, fn {_id, name} -> name end)}
          type="button"
          phx-click="unignore_target"
          phx-value-id={id}
          id={"scout-targets-ignored-#{id}"}
          title="Put this system back on the route"
          class="badge badge-sm gap-1 border-0 bg-neutral-800 text-gray-300 hover:bg-neutral-700"
        >
          {name} ✕
        </button>
        <button
          type="button"
          phx-click="clear_targets_ignore"
          id="scout-targets-ignored-clear"
          class="btn btn-xs btn-ghost text-gray-400"
        >
          Clear all
        </button>
      </div>
    </div>

    <.note :if={@targets_error == :no_targets} id="scout-targets-none">
      Nothing matches these filters — no {Enum.map_join(
        @targets_families,
        " / ",
        &String.downcase(Targets.family_label(&1))
      )} finding is both recent enough and reachable. That is the good day.
    </.note>

    <.note :if={@targets_error && @targets_error != :no_targets} id="scout-targets-error">
      {plan_error_message(@targets_error)}
    </.note>

    <.note :if={@targets_loading? and is_nil(@targets_result)} id="scout-targets-loading">
      Finding targets…
    </.note>

    <.scout_pane :if={@targets_result} loading={@targets_loading?}>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5">
        <.stat label="Target systems" value={to_string(@targets_result.route.systems)} />
        <.stat
          label="Structures"
          value={to_string(targets_structures(@targets_result))}
          hint={"of #{@targets_result.candidates} systems found"}
        />
        <.stat label="Total jumps" value={to_string(@targets_result.route.jumps)} />
        <.stat
          label="Waypoints"
          value={to_string(length(@targets_result.route.waypoints))}
          hint={
            if @targets_result.route.compressed?, do: "after compression", else: "uncompressed"
          }
        />
      </div>

      <p
        :if={targets_excluded_summary(@targets_result, @targets_radius) != ""}
        id="scout-targets-excluded"
        class="text-[11px] text-gray-500 mb-3"
      >
        Not on this route: {targets_excluded_summary(@targets_result, @targets_radius)}.
      </p>

      <div class="flex flex-wrap items-center gap-2 mb-3">
        <form phx-change="select_character" class="flex items-center gap-2">
          <select
            name="character_eve_id"
            id="scout-targets-character"
            title="Whose autopilot this route is written to, through ESI"
            class="select select-sm select-bordered bg-neutral-950/60 py-0 max-w-[12rem]"
          >
            <option
              :for={character <- @characters}
              value={character.eve_id}
              selected={character.eve_id == @character_eve_id}
            >
              {character.name}
            </option>
          </select>
        </form>
        <button
          type="button"
          phx-click="set_targets_route"
          id="scout-targets-set-route"
          disabled={@characters == []}
          title="Replaces this character's in-game route with the target run, in order"
          class="btn btn-sm btn-primary"
        >
          Set route
        </button>
        <.route_outcome status={@route_status} scope={:targets} />
      </div>

      <.panel
        id="scout-targets-table-panel"
        title="Target route"
        count={length(@targets_result.route.stops)}
        hint="soonest predicted deadline is an upper bound, never a timer"
      >
        <.grid id="scout-targets-table">
          <thead>
            <tr>
              <th class="text-right">#</th>
              <th>System</th>
              <th>Region</th>
              <th>Findings</th>
              <th>Out by</th>
              <th>Last seen</th>
              <th class="text-right">Jumps</th>
              <th>WP</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <tr
              :for={stop <- @targets_result.route.stops}
              id={"scout-target-#{stop.solar_system_id}"}
            >
              <td class="text-right text-xs text-gray-500">{stop.order}</td>
              <td>
                <div class="flex items-center gap-1.5 whitespace-nowrap">
                  {stop.name}
                  <.space_badge space={stop.space} />
                </div>
              </td>
              <td class="text-xs text-gray-400">{stop.region_name || "—"}</td>
              <td>
                <.target_findings target={target_of(@targets_result, stop.solar_system_id)} />
              </td>
              <td>
                <.target_deadline
                  target={target_of(@targets_result, stop.solar_system_id)}
                  now={@now}
                />
              </td>
              <td>
                <.target_seen
                  target={target_of(@targets_result, stop.solar_system_id)}
                  now={@now}
                />
              </td>
              <td class="text-right tabular-nums">{stop.jumps_from_prev}</td>
              <td><.waypoint_badge waypoint?={stop.waypoint?} /></td>
              <td class="text-right">
                <button
                  type="button"
                  phx-click="ignore_target"
                  phx-value-id={stop.solar_system_id}
                  phx-value-name={stop.name}
                  id={"scout-target-#{stop.solar_system_id}-ignore"}
                  title="Drop this system from the route — undo it from the Ignored chips above"
                  class="btn btn-ghost btn-xs text-gray-500 hover:text-error"
                >
                  ✕
                </button>
              </td>
            </tr>
            <.empty :if={@targets_result.route.stops == []} cols={9}>
              Nothing to fly to.
            </.empty>
          </tbody>
        </.grid>
      </.panel>

      <%!-- A finding the route could not take. Listed, never dropped
            silently: a wormhole has no gate path and an out-of-radius
            target is a choice, not an absence. --%>
      <.panel
        :if={@targets_result.excluded.radius != [] or @targets_result.excluded.unroutable != []}
        id="scout-targets-excluded-panel"
        title="Left out"
        count={
          length(@targets_result.excluded.radius) + length(@targets_result.excluded.unroutable)
        }
        hint="real findings this route does not visit"
      >
        <.grid id="scout-targets-excluded-table">
          <thead>
            <tr>
              <th>System</th>
              <th>Region</th>
              <th>Findings</th>
              <th>Why</th>
              <th>Last seen</th>
            </tr>
          </thead>
          <tbody>
            <tr
              :for={
                {t, why} <-
                  Enum.map(
                    @targets_result.excluded.radius,
                    &{&1, "beyond #{@targets_radius} jumps"}
                  ) ++
                    Enum.map(@targets_result.excluded.unroutable, &{&1, "no gate route"})
              }
              id={"scout-target-out-#{t.solar_system_id}"}
            >
              <td>
                <div class="flex items-center gap-1.5 whitespace-nowrap">
                  {t.name}
                  <.space_badge space={t.space} />
                </div>
              </td>
              <td class="text-xs text-gray-400">{t.region_name || "—"}</td>
              <td class="text-xs text-gray-300">
                {plural(t.structures, "structure", "structures")}
              </td>
              <td class="text-xs text-gray-500">{why}</td>
              <td><.seen at={t.last_confirmed_at} now={@now} /></td>
            </tr>
          </tbody>
        </.grid>
      </.panel>
    </.scout_pane>
  </div>
<% else %>
  <%!-- One-line muted notice, not a redirect: this child cannot
        `push_navigate/2` or `push_patch/2` out from under the shell
        it is nested in (moduledoc), so a gate failure stays right here. --%>
  <.note id="scout-planner-denied">{@denial}</.note>
<% end %>
