<main class="w-full h-full p-4 pl-20 pb-20 overflow-auto text-gray-200">
  <div class="flex items-baseline justify-between mb-6 flex-wrap gap-2">
    <h1 class="text-2xl font-semibold">Management</h1>
    <div class="flex gap-2">
      <.link navigate={~p"/corp/identity"} class="btn btn-sm" id="link-corp-identity">
        Your identity
      </.link>
      <.link
        :if={@is_corp_admin? and @corp_flags[:group_map_sync_enabled?]}
        navigate={~p"/corp/map-grants"}
        class="btn btn-sm"
        id="link-corp-map-grants"
      >
        Map access grants
      </.link>
      <.link
        :if={@can_view_scout_log? and @corp_flags[:scout_intel_enabled?]}
        navigate={~p"/corp/scout"}
        class="btn btn-sm"
        id="link-corp-scout"
      >
        Scout log
      </.link>
    </div>
  </div>

  <p :if={not @corp_flags[:corp_roster_enabled?]} class="text-gray-400" id="corp-roster-disabled">
    The corp roster is not enabled on this deployment (WANDERER_CORP_ROSTER). Set your main
    character under "Your identity" — that works regardless.
  </p>

  <div :if={@corp_flags[:corp_roster_enabled?]}>
    <p class="mb-6 text-gray-400">
      Live current-state roster from ESI member tracking — every character in the corp,
      including people who have never opened this app. Sorted by longest-since-last-login
      first; members who have left trail at the bottom.
    </p>

    <p :if={@near_page_limit?} class="mb-6 text-warning" id="corp-roster-page-limit-warning">
      This roster is near or over 100 active members. The roster feed only
      fetches the first 100-row page from ESI right now -- members beyond
      that may be silently missing. See WandererApp.Esi.ApiClient.get_corp_membertracking/2.
    </p>

    <div class="mb-8 border border-gray-700 rounded p-4" id="grant-director-access">
      <h2 class="text-lg font-semibold mb-2">Grant director access</h2>
      <p class="text-sm text-gray-400 mb-2">
        If you hold the Director role for this corp in-game, click below to let this app
        read the corp's full member roster (last login/logout, location, ship) via ESI --
        a corp-wide read permission on top of your normal map login. Only useful if your
        character actually has the in-game Director role: if it doesn't, this app still
        logs you in normally, but the roster stays unpopulated (visibly `:stalled`, not
        broken) until a character who does have it grants access.
      </p>
      <button type="button" phx-click="request_director_access" class="btn btn-sm">
        Grant director access
      </button>
    </div>

    <div :if={@is_corp_admin?} class="mb-8 border border-gray-700 rounded p-4">
      <h2 class="text-lg font-semibold mb-2">Director token holder</h2>
      <div :for={corp <- @corps} class="flex items-center gap-2 mb-2" id={"director-row-#{corp.id}"}>
        <span class="w-48 text-gray-400">{corp.name}</span>
        <form phx-submit="set_director" class="flex items-center gap-2">
          <input type="hidden" name="corporation_id" value={corp.id} />
          <select name="character_id" class="select select-sm select-bordered">
            <option value="">Choose a character</option>
            <option
              :for={character <- Map.get(@characters_by_corp, corp.eve_corporation_id, [])}
              value={character.id}
              selected={character.id == corp.director_character_id}
            >
              {character.name}
            </option>
          </select>
          <button type="submit" class="btn btn-xs">Set</button>
        </form>
        <% status = Map.get(@token_status_by_corp, corp.id) %>
        <span :if={match?({:ok, _}, status)} class="text-xs text-success">
          token resolves ({elem(status, 1)})
        </span>
        <span :if={match?({:error, :no_director_token}, status)} class="text-xs text-warning">
          not configured -- roster sync for this corp is not scheduled
        </span>
        <span
          :if={match?({:error, _}, status) and not match?({:error, :no_director_token}, status)}
          class="text-xs text-error"
        >
          token does not resolve: {inspect(elem(status, 1))}
        </span>
        <span :if={corp.enabled} class="badge badge-sm badge-success">sync enabled</span>
        <span
          :if={not corp.enabled}
          class="badge badge-sm badge-warning"
          id={"corp-sync-disabled-#{corp.id}"}
        >
          sync disabled -- this corp is never polled, even with a working director token
        </span>
        <button
          phx-click="toggle_enabled"
          phx-value-corporation_id={corp.id}
          class="btn btn-xs"
          id={"toggle-enabled-#{corp.id}"}
        >
          {if corp.enabled, do: "Disable sync", else: "Enable sync"}
        </button>
      </div>
    </div>

    <table class="table w-full" id="corp-roster-table">
      <thead>
        <tr>
          <th>Character</th>
          <th>Status</th>
          <th>Last logon</th>
          <th>Days since logon</th>
          <th>Location</th>
          <th>Ship</th>
        </tr>
      </thead>
      <tbody>
        <tr :for={row <- @roster_rows} id={"roster-row-#{row.character_id}"}>
          <td>{row.name || "Character #{row.character_id}"}</td>
          <td>
            <span class={[
              "badge",
              row.status == :active && "badge-success",
              row.status == :departed && "badge-ghost"
            ]}>
              {row.status}
            </span>
          </td>
          <td>{row.logon_at}</td>
          <td>{row.days_since_logon}</td>
          <td>{row.location_name || row.location_id}</td>
          <td>{row.ship_type_name || row.ship_type_id}</td>
        </tr>
      </tbody>
    </table>
  </div>
</main>
